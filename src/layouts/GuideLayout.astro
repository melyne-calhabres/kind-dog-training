---
import Layout from './Layout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { title, description, date, lastModified, image, imageAlt, tags } = guide.data;

const siteUrl = Astro.site?.origin ?? 'https://mondomaine.fr';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: date.toISOString(),
  ...(lastModified && { dateModified: lastModified.toISOString() }),
  ...(image && { image: `${siteUrl}${image}` }),
  author: {
    '@type': 'Person',
    name: 'Mélyne',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Kind Dog Training',
    url: siteUrl,
  },
};

const formattedDate = date.toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={`${title} — Kind Dog Training`}
  description={description}
  ogImage={image}
  type="article"
  jsonLd={jsonLd}
>
  <article class="section">
    <div class="container" style="max-width: 750px;">
      <header class="guide-header">
        <p class="eyebrow" style="margin-bottom: var(--sp-4);">Guide</p>
        <h1>{title}</h1>
        <p class="guide-meta">
          <time datetime={date.toISOString()}>{formattedDate}</time>
        </p>
        {tags && tags.length > 0 && (
          <ul class="guide-tags">
            {tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        )}
      </header>

      {image && (
        <img
          src={image}
          alt={imageAlt ?? ''}
          class="guide-cover"
          width="750"
          height="420"
          loading="eager"
        />
      )}

      <div class="guide-content">
        <slot />
      </div>

      <footer style="margin-top: var(--sp-16); padding-top: var(--sp-8); border-top: 1px solid var(--kd-cream-deep); text-align: center;">
        <p style="color: var(--kd-bark); margin-bottom: var(--sp-4);">
          Besoin d'un accompagnement personnalisé ?
        </p>
        <a href="/prendre-rdv/" class="btn btn-primary">
          Prendre RDV
        </a>
      </footer>
    </div>
  </article>
</Layout>
