---
import Layout from '../layouts/Layout.astro';

const siteUrl = Astro.site?.origin ?? 'https://kind-dog-training.fr';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Kind Dog Training',
  description: "Éducateur canin à Bordeaux. Méthodes positives et bienveillantes pour chiots et chiens adultes, toutes races. Bilan comportemental gratuit à domicile.",
  url: siteUrl,
  email: 'kindogtraining@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '415 route du Médoc',
    postalCode: '33520',
    addressLocality: 'Bruges',
    addressRegion: 'Nouvelle-Aquitaine',
    addressCountry: 'FR',
  },
  areaServed: {
    '@type': 'GeoCircle',
    geoMidpoint: {
      '@type': 'GeoCoordinates',
      latitude: 44.8378,
      longitude: -0.5792,
    },
    geoRadius: '30000',
  },
  telephone: '+33642648914',
  priceRange: '€€',
  image: `${siteUrl}/images/og-default.jpg`,
  sameAs: ['https://www.instagram.com/kind_dog_training/'],
};

const faqItems = [
  {
    question: "À quoi sert le bilan comportemental et pourquoi est-il gratuit ?",
    answer: "Le bilan est un premier rendez-vous à votre domicile, sans engagement. Il me permet de comprendre votre situation, d'observer votre chien dans son environnement et de vous proposer un plan d'action sur-mesure. Si la méthode vous convient, on planifie un premier cours. Sinon, vous n'avez rien perdu."
  },
  {
    question: "Combien coûte un éducateur canin à Bordeaux ?",
    answer: "Chaque accompagnement pour votre chiot/chien démarre par un bilan gratuit à votre domicile (ou 20€ si >20km). Vous avez ensuite la possibilité de prendre vos cours de manière individuelle pour 50€/cours ou de payer plusieurs cours à l'avance grâce aux packs."
  },
  {
    question: "Quelle est votre zone d'intervention ?",
    answer: "J'interviens à Bordeaux et dans toutes les communes de la métropole : Mérignac, Pessac, Talence, Bègles, Villenave-d'Ornon, Bruges, Le Bouscat, Eysines, Floirac et alentours. J'accompagne également des chiens qui sont dans le médoc."
  },
  {
    question: "Pour quelles races donnez-vous des cours d'éducation canine à Bordeaux ?",
    answer: "Je donne des cours d'éducation canine autour de Bordeaux pour TOUTES les races !"
  },
  {
    question: "Combien de séances faut-il pour éduquer un chien ?",
    answer: "Cela dépend d'énormément de facteurs qui vont impacter les progrès de votre chien : le/les problèmes que l'on va traiter, la capacité du chien à répondre aux exercices proposés, votre capacité de travail en dehors des cours, la régularité des cours. Je serais en mesure de vous donner une estimation même grossière après un bilan mais il est impossible de donner une réponse à une question aussi générique."
  },
  {
    question: "À quel âge commencer l'éducation de mon chiot ?",
    answer: "Il n'y a pas vraiment d'âge plus adapté. Vous pouvez très bien démarrer les cours pour votre chiot dès son arrivée à 2 mois ou plus tard si vous en ressentez le besoin. Néanmoins, le plus tôt est le mieux afin d'être sûr de construire l'éducation et le comportement de votre chiot sur de bonnes bases !"
  },
  {
    question: "Les cours se déroulent-ils en groupe ou de manière individuelle ?",
    answer: "Je propose des cours individuels et collectifs. Pour ce qui est de la problématique principale de votre chien vous aurez bien évidemment accès à des cours individuels. Cependant, si votre situation le permet, vous pourrez également participer à des cours collectifs qui sont organisés régulièrement sur Bordeaux."
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const steps = [
  {
    icon: 'home',
    title: 'Bilan comportemental à domicile',
    desc: "Chaque accompagnement débute par un bilan gratuit à votre domicile (20 € si > 20 km). Un état des lieux, sans engagement.",
  },
  {
    icon: 'clipboard-list',
    title: "Plan d'action sur-mesure",
    desc: "Je vous propose un plan adapté à votre chien, votre quotidien, vos objectifs. Cours individuel ou pack, à vous de choisir.",
  },
  {
    icon: 'clock',
    title: "Cours d'une heure maximum",
    desc: "Vous avez l'assurance que votre chien progresse à chaque cours. Je suis éducateur & comportementaliste canin et je suis donc là pour vous aider à faire progresser votre chien et à améliorer votre relation avec lui, pas pour vous prendre votre argent à travers des dizaines de cours inutiles.",
  },
  {
    icon: 'book-open',
    title: 'Bilan écrit après chaque cours',
    desc: "Après chaque cours, vous aurez accès à un bilan écrit de manière à vous rappeler les objectifs du cours, les exercices travaillés, les progrès de votre chien et les petits devoirs que vous aurez à faire (exercices à travailler chez vous).",
  },
  {
    icon: 'message-circle',
    title: 'Suivi WhatsApp 7j/7',
    desc: "Vous aurez également un suivi WhatsApp 7j/7 pour toute question. Je réponds à tous les messages sous 48h maximum.",
  },
];

const promises = [
  "Je n'utilise aucune méthode douteuse ni aucun outil qui pourrait blesser physiquement votre chien.",
  "Je ne conclurai jamais un accompagnement en vous disant « c'est un <race>, il sera toujours comme ça ».",
  "Je ne vous conseillerai jamais de médicamenter votre chien (c'est le travail d'un vétérinaire).",
  "Je ne vous conseillerai jamais de déménager.",
  "Je ne vous ferai pas payer un cours pour vous apprendre à tenir une longe.",
  "Je m'adapte à VOTRE situation et VOTRE quotidien, pas l'inverse.",
];

---

<Layout
  title="Kind Dog Training — Educateur canin à Bordeaux"
  description="Besoin d'un éducateur canin à Bordeaux ? Faites appel à Kind Dog Training ! Pour chiens agressifs/réactifs, petits problèmes de comportement/obéissance ou chiots"
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container">
      <div class="hero-content">
        <p class="eyebrow" aria-hidden="true">Kind Dog Training</p>
        <h1 id="hero-heading">Educateur canin à <span class="accent">Bordeaux</span></h1>
        <p class="hero-subtitle">
          Education & rééducation pour chiots et chiens adultes <span class="accent">toutes races</span>.
        </p>
        <div class="hero-actions">
          <a href="/tarif-educateur-canin-bordeaux" class="btn btn-secondary">
            Voir les tarifs
            <i data-lucide="arrow-right" style="width:16px;height:16px;stroke-width:2" aria-hidden="true"></i>
          </a>
          <a href="/prendre-rdv/" class="btn btn-primary">
            Prendre RDV
            <i data-lucide="calendar" style="width:16px;height:16px;stroke-width:2" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY SECTION -->
  <section class="section why-section" id="pourquoi" aria-labelledby="pourquoi-heading">
    <div class="container">
      <div class="why-header">
        <h2 id="pourquoi-heading">Pourquoi faire appel à un <span class="accent">éducateur comportementaliste canin ?</span></h2>
        <div class="separator"></div>
      </div>
      <div class="why-grid">
        <div class="why-card">
          <span class="why-icon" aria-hidden="true">
            <i data-lucide="paw-print" style="width:32px;height:32px;stroke-width:1.75"></i>
          </span>
          <h3 class="why-card-title">Les débuts du chiot</h3>
          <p class="why-card-desc">Créer une relation solide et apprendre à se contrôler en toutes circonstances.</p>
        </div>
        <div class="why-card why-card-bordered">
          <span class="why-icon" aria-hidden="true">
            <i data-lucide="dog" style="width:32px;height:32px;stroke-width:1.75"></i>
          </span>
          <h3 class="why-card-title">Les basiques du chien adulte</h3>
          <p class="why-card-desc">Connaître/retravailler les ordres de base et approfondir sa capacité à se gérer face à tous types de stimulations.</p>
        </div>
        <div class="why-card">
          <span class="why-icon" aria-hidden="true">
            <i data-lucide="shield-alert" style="width:32px;height:32px;stroke-width:1.75"></i>
          </span>
          <h3 class="why-card-title">Problèmes de comportement</h3>
          <p class="why-card-desc">Trouver des solutions adaptées pour le chien peureux, anxieux, ou agressif.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- APPROACH -->
  <section class="section" id="methode" aria-labelledby="methode-heading">
    <div class="container">
      <div class="approach-grid">
        <div class="approach-sticky">
          <h2 id="methode-heading">La méthode <span class="accent">Kind Dog Training</span></h2>
          <img src="/images/melyneetramsey.png" alt="Mélyne, éducateur canin à Bordeaux, avec son chien Ramsey" width="1080" height="900" class="approach-photo" />
        </div>

        <div>
          <ol>
            {steps.map((step) => (
              <li class="step-item">
                <span class="icon-box icon-box-lg" aria-hidden="true">
                  <i data-lucide={step.icon} style="width:22px;height:22px;stroke-width:1.75"></i>
                </span>
                <div>
                  <h3 class="step-title">{step.title}</h3>
                  <p class="step-desc">{step.desc}</p>
                </div>
              </li>
            ))}
          </ol>

        </div>
      </div>
      <div class="approach-ctas">
        <a href="/tarif-educateur-canin-bordeaux" class="btn btn-secondary">
          Voir les tarifs
          <i data-lucide="arrow-right" style="width:16px;height:16px;stroke-width:2" aria-hidden="true"></i>
        </a>
        <a href="/prendre-rdv/" class="btn btn-primary">
          Prendre RDV
          <i data-lucide="calendar" style="width:16px;height:16px;stroke-width:2" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <div class="wave-separator" aria-hidden="true">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,40 C320,80 640,0 960,50 C1120,70 1320,30 1440,40 L1440,80 L0,80 Z" fill="#2A1E15"/>
    </svg>
  </div>
  <section class="kdtA" aria-label="Avis Google clients" id="temoignages">
    <div class="kdtA__header">
      <div class="kdtA__intro">
        <div class="kdtA__eyebrow">Avis Google</div>
        <h2 class="kdtA__title">Ce qu'en disent <span class="accent">les humains & leurs chiens</span></h2>
        <p class="kdtA__lede">Des binômes de Bordeaux et alentours qui ont retrouvé du calme, de la complicité et de la confiance.</p>
      </div>
      <div class="kdtA__rating">
        <div class="kdtA__rating-num" data-kdt-rating-num>5.0</div>
        <div class="kdtA__rating-meta">
          <div class="kdtA__rating-stars" data-kdt-rating-stars></div>
          <div>Basé sur <span data-kdt-rating-count>13</span> avis Google</div>
          <a class="kdtA__rating-link" data-kdt-rating-link href="#" target="_blank" rel="noopener">
            <span data-kdt-rating-link-icon></span> Voir sur Google
          </a>
        </div>
      </div>
    </div>

    <div class="kdtA__carousel">
      <div class="kdtA__viewport" data-kdt-viewport>
        <div class="kdtA__track" data-kdt-track></div>
      </div>
      <div class="kdtA__controls">
        <div class="kdtA__dots" data-kdt-dots></div>
        <div class="kdtA__arrows">
          <button class="kdtA__arrow" data-kdt-prev aria-label="Précédent">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="11 6 5 12 11 18"/></svg>
          </button>
          <button class="kdtA__arrow" data-kdt-next aria-label="Suivant">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
  (function() {
    var KDT_REVIEWS = [
      { name: "M H", rating: 5, date: "Il y a une semaine",
        text: "Quand vous pensez que rien ne fonctionnera et que vous êtes à deux doigts de renoncer, allez il faut y croire encore une dernière fois et appeler Mélyne (en vrai, faites le dès le début, vous gagnerez du temps et beaucoup beaucoup d'énergie). Au-delà de ses qualités personnelles (Mélyne est vraiment super), elle est une professionnelle qui ne s'est pas improvisée éducateur canin du jour au lendemain. Il y a du boulot derrière, de l'expérience, de la formation, etc. Et quand on a eu affaire à d'autres éducateurs, ça se voit mais alors de suite et on peut dire que ça fait une énorme différence, évidemment. Ce qui est aussi cool, c'est que les séances sont très agréables, Mélyne s'adapte tant à l'humain qu'à son chien. Les exercices sont très efficaces et demandent de la régularité mais pas non plus d'y passer des heures entières chaque jour. Ma petite Staffie n'écoutait rien du tout, quasi aucun rappel, la marche en laisse c'était plutôt du tirage en laisse, bref, le quotidien était vraiment compliqué. Et grâce à Mélyne, en très peu de temps (la marche en laisse ça a été réglé en 1/2 séance par exemple), les bases (et même plus) sont désormais acquises et ça change la vie! Et même quand ça roule, on a envie de progresser sur d'autres aspects éducatifs, juste parce que c'est cool d'apprendre et de travailler avec notre chien, pas uniquement parce que c'est nécessaire. Donc mille mercis à Mélyne." },
      { name: "Bastien Dupont", rating: 5, date: "Il y a 2 semaines",
        text: "Ma compagne et moi avons fait appel à Mélyne car nous étions en difficulté. Elle a su nous conseiller et nous orienter de la meilleur façon possible de façon très réactive et à notre écoute ! Elle aide autant nos amis à quatre pattes que leurs propriétaires." },
      { name: "Coralie Bonnet", rating: 5, date: "Il y a 2 semaines",
        text: "Mélyne est d'une écoute précieuse et s'adapte parfaitement au chien comme à son maître. Elle nous a aidé grandement à faire évoluer Mucho qui est beaucoup plus serein dans les rencontres avec les congénères et beaucoup moins réactif ! C'est LA meilleure éducatrice de Bordeaux." },
      { name: "Aub'Animaux", rating: 5, date: "Il y a 3 semaines",
        text: "Mélyne est une passionnée du chien et de son travail d'éducatrice. Elle est le genre de professionnelle à persévérer : elle ne s'arrête pas à un protocole ou à une méthode qui ne correspond pas à un chien. Elle a tout un tas d'outils dans sa besace, elle sort des sentiers battus et se creuse la tête pour trouver ce qui correspond au chien. Mon chien est un cas très complexe. J'ai vu des éducateurs l'ayant considéré comme « le pire chien qu'ils aient vu », « un tueur », et qui agit par « méchanceté gratuite ». Mélyne, elle, a vu plus loin. Elle a pris le temps, elle a observé dans tous les contextes possibles. Aucun jugement de sa part, uniquement des faits, des conseils, des explications. Nous avons du coup pu trouver des pistes et des choses à travailler pour avancer dans la bonne direction. Merci KDT, À bientôt 🐾" },
      { name: "Victoria Pointet", rating: 5, date: "Il y a un mois",
        text: "J'ai commencé à travailler avec Mélyne quand Brooklyn avait 4 mois, et honnêtement… quelle chance on a eue de la rencontrer ! Elle nous a accompagnés sur toutes les bases à instaurer, ainsi que la gestion des émotions, le rappel, la marche en laisse… toujours avec douceur et bonne humeur. Les résultats ont été rapides et durables." },
      { name: "twinzeko", rating: 5, date: "Il y a 2 mois",
        text: "Mélyne nous suit depuis bientôt un an et c'est un réel bonheur. Une écoute attentive et de très bons conseils. On voit une vraie différence dans le comportement de notre petite Appa qui a frôlé la réactivité mais qu'on a réussi à corriger ! Une éducatrice qui met le chien au centre de la discussion et fait passer le bien-être animal en priorité." },
      { name: "Cleora", rating: 5, date: "Il y a 2 mois",
        text: "J'ai contacté Mélyne car je voulais mieux comprendre mon chien Vaillant, récemment adopté en refuge. Le contact a tout de suite été très naturel et Vaillant a eu un vrai coup de cœur pour notre coach ! Mélyne est très bienveillante et à l'écoute. Petit bonus, chaque séance fait l'objet d'un compte-rendu écrit, ce qui est très appréciable !" },
      { name: "Cathy Le Corre", rating: 5, date: "Il y a 2 mois",
        text: "Une Educ au top, plein de bons conseils, consultée pour un toutou réactif ayant une mauvaise gestion des émotions (frustration, difficulté de renoncement, tirage en laisse, aboiements…) et des progrès dès la première séance ! Un accompagnement étape par étape avec un bilan à chaque séance, rien à dire, parfait !" },
      { name: "Jacques", rating: 5, date: "Il y a 3 mois",
        text: "J'ai fait appel à Mélyne pour régler quelques problèmes avec mon staffy de 7 ans, notamment pour un problème de communication avec ses congénères. Les cours ont été très concluants, les exercices sont simples et efficaces. Bilan gratuit, éducation positive et rempli d'amour. On voit que c'est pour Mélyne une vraie passion avant tout." },
      { name: "axelmrquand", rating: 5, date: "Il y a 3 mois",
        text: "Mélyne suit notre Shikoku depuis plusieurs mois à distance et fait un travail remarquable, à tel point que nous avons fait un stage avec elle. Elle donne des exercices faciles à mettre en place et efficaces. Son bilan est très synthétique, clair et ordonné. Mélyne ne fuit pas la difficulté, propose un service honnête, efficace, bienveillant et fonctionnel." },
      { name: "Pauline", rating: 5, date: "Il y a 3 mois",
        text: "Je recommande Mélyne sans hésiter. J'ai une staffie de 2 ans qui montait beaucoup en excitation avec son grand frère chien, qui avait peur des vélos et pour qui la marche en laisse au pied était compliquée. Grâce à l'écoute et le professionnalisme de Mélyne, les progrès ont été rapides et concrets." },
      { name: "Marie L.", rating: 5, date: "Il y a 4 mois",
        text: "Mélyne est une éducatrice exceptionnelle. Patiente, à l'écoute et toujours dans la bienveillance, elle a su comprendre Nala et nous donner les clés pour mieux communiquer avec elle. Les progrès ont été visibles dès les premières séances. Je la recommande chaudement !" }
    ];

    var KDT_GOOGLE_URL = "https://share.google/y9oqE2AvoPW7WO68S";
    var KDT_RATING = 5.0;
    var KDT_REVIEW_COUNT = 13;

    var PALETTES = [
      ["#C8623A", "#E8A33D"], ["#9B6B47", "#C8623A"], ["#5A8084", "#8FB4B8"],
      ["#C8623A", "#E8B89A"], ["#7A5A3F", "#C8623A"], ["#A0764D", "#E8A33D"]
    ];
    function initials(name) {
      if (!name) return "?";
      var parts = name.trim().split(/\s+/).filter(Boolean);
      if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
      return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
    }
    function avatarBg(idx) {
      var p = PALETTES[idx % PALETTES.length];
      return "linear-gradient(135deg, " + p[0] + ", " + p[1] + ")";
    }
    function starSvg(filled, size) {
      size = size || 17;
      return '<svg viewBox="0 0 24 24" width="' + size + '" height="' + size + '" aria-hidden="true">' +
        '<path d="M12 2.5l2.95 6.6 7.05.7-5.35 4.85 1.6 7.35L12 18l-6.25 4 1.6-7.35L2 9.8l7.05-.7L12 2.5z" ' +
        'fill="' + (filled ? '#E8A33D' : 'transparent') + '" stroke="#E8A33D" stroke-width="1.2" stroke-linejoin="round"/></svg>';
    }
    function starsHtml(rating, size) {
      var html = '';
      for (var i = 0; i < 5; i++) html += starSvg(i < rating, size);
      return html;
    }
    function googleMark(size) {
      size = size || 22;
      return '<svg viewBox="0 0 48 48" width="' + size + '" height="' + size + '" aria-hidden="true">' +
        '<path fill="#4285F4" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.2-.1-2.3-.4-3.5z"/>' +
        '<path fill="#34A853" d="M6.3 14.1l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.1z"/>' +
        '<path fill="#FBBC05" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2c-2 1.4-4.5 2.4-7.2 2.4-5.2 0-9.6-3.3-11.2-7.9l-6.5 5C9.6 39.6 16.2 44 24 44z"/>' +
        '<path fill="#EA4335" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.1-4.1 5.5l6.2 5.2C40.7 35.7 44 30.3 44 24c0-1.2-.1-2.3-.4-3.5z"/></svg>';
    }
    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, function(c) {
        return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c];
      });
    }

    var widget = document.getElementById('temoignages');
    if (!widget) return;

    widget.querySelector('[data-kdt-rating-num]').textContent = KDT_RATING.toFixed(1);
    widget.querySelector('[data-kdt-rating-count]').textContent = KDT_REVIEW_COUNT;
    widget.querySelector('[data-kdt-rating-stars]').innerHTML = starsHtml(5, 16);
    var ratingLink = widget.querySelector('[data-kdt-rating-link]');
    ratingLink.href = KDT_GOOGLE_URL;
    widget.querySelector('[data-kdt-rating-link-icon]').innerHTML = googleMark(14);

    var track = widget.querySelector('[data-kdt-track]');
    KDT_REVIEWS.forEach(function(r, i) {
      var card = document.createElement('article');
      card.className = 'kdtA__card';
      card.innerHTML =
        '<div class="kdtA__card-head">' +
          '<div class="kdtA__avatar" style="background:' + avatarBg(i) + '">' + escapeHtml(initials(r.name)) + '</div>' +
          '<div class="kdtA__name-block">' +
            '<div class="kdtA__name">' + escapeHtml(r.name) + '</div>' +
            '<div class="kdtA__date">' + escapeHtml(r.date) + '</div>' +
          '</div>' +
          googleMark(20) +
        '</div>' +
        '<div class="kdtA__stars">' + starsHtml(r.rating, 17) + '</div>' +
        '<p class="kdtA__text">' + escapeHtml(r.text) + '</p>';
      track.appendChild(card);
    });

    var index = 0, perView = 3;
    var paused = false;
    var dotsContainer = widget.querySelector('[data-kdt-dots]');
    var prevBtn = widget.querySelector('[data-kdt-prev]');
    var nextBtn = widget.querySelector('[data-kdt-next]');
    var viewport = widget.querySelector('[data-kdt-viewport]');

    function computePerView() {
      var w = window.innerWidth;
      if (w < 640) return 1;
      if (w < 960) return 2;
      return 3;
    }
    function maxIndex() { return Math.max(0, KDT_REVIEWS.length - perView); }

    function renderDots() {
      dotsContainer.innerHTML = '';
      for (var i = 0; i <= maxIndex(); i++) {
        var d = document.createElement('button');
        d.className = 'kdtA__dot' + (i === Math.min(index, maxIndex()) ? ' kdtA__dot--active' : '');
        d.setAttribute('aria-label', 'Aller à la position ' + (i + 1));
        (function(i) { d.addEventListener('click', function() { goTo(i); }); })(i);
        dotsContainer.appendChild(d);
      }
    }

    function update() {
      var safe = Math.min(index, maxIndex());
      index = safe;
      var gap = 20;
      var cardWidth = 100 / perView;
      var basis = 'calc(' + cardWidth + '% - ' + (gap * (perView - 1) / perView) + 'px)';
      [].forEach.call(track.children, function(c) { c.style.flexBasis = basis; });
      var firstCard = track.children[0];
      var targetCard = track.children[safe];
      if (firstCard && targetCard) {
        var offset = targetCard.offsetLeft - firstCard.offsetLeft;
        track.style.transform = 'translateX(-' + offset + 'px)';
      } else {
        track.style.transform = 'translateX(0)';
      }
      prevBtn.disabled = safe === 0;
      nextBtn.disabled = safe >= maxIndex();
      renderDots();
    }

    function goTo(i) {
      index = Math.max(0, Math.min(maxIndex(), i));
      update();
    }

    prevBtn.addEventListener('click', function() { goTo(index - 1); });
    nextBtn.addEventListener('click', function() { goTo(index + 1); });

    window.addEventListener('resize', function() {
      perView = computePerView();
      update();
    });

    widget.addEventListener('mouseenter', function() { paused = true; });
    widget.addEventListener('mouseleave', function() { paused = false; });
    setInterval(function() {
      if (paused) return;
      if (index >= maxIndex()) goTo(0); else goTo(index + 1);
    }, 5500);

    var dragStart = null;
    function onDown(e) {
      dragStart = (e.touches ? e.touches[0].clientX : e.clientX);
    }
    function onUp(e) {
      if (dragStart === null) return;
      var endX = (e.changedTouches ? e.changedTouches[0].clientX : e.clientX);
      var dx = endX - dragStart;
      if (Math.abs(dx) > 50) goTo(index + (dx < 0 ? 1 : -1));
      dragStart = null;
    }
    viewport.addEventListener('mousedown', onDown);
    viewport.addEventListener('mouseup', onUp);
    viewport.addEventListener('touchstart', onDown, { passive: true });
    viewport.addEventListener('touchend', onUp);

    perView = computePerView();
    update();
  })();
  </script>

