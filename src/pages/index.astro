  <script is:inline>
  (function () {
    var carousel = document.getElementById('dog-carousel');
    if (!carousel) return;
    var prev = document.querySelector('[data-kdt-dog-prev]');
    var next = document.querySelector('[data-kdt-dog-next]');
    if (!prev || !next) return;
    function scrollByOne(dir) {
      var photo = carousel.querySelector('.dog-photo');
      if (!photo) return;
      carousel.scrollBy({ left: dir * (photo.offsetWidth + 12), behavior: 'smooth' });
    }
    prev.addEventListener('click', function () { scrollByOne(-1); });
    next.addEventListener('click', function () { scrollByOne(1); });
  })();
  </script>

