    <script>
      (function () {
        var mq = window.matchMedia('(max-width: 767px)');
        var region = document.getElementById('lp-form');
        var body = document.body;
        var firstInput = document.getElementById('prenom');

        function focusFirst(preventScroll) {
          if (firstInput) {
            try { firstInput.focus({ preventScroll: !!preventScroll }); }
            catch (e) { firstInput.focus(); }
          }
        }
        function openModal() {
          region.classList.add('is-open');
          body.classList.add('lp-modal-open');
          document.addEventListener('keydown', onKey);
          setTimeout(function () { focusFirst(true); }, 60);
        }
        function closeModal() {
          region.classList.remove('is-open');
          body.classList.remove('lp-modal-open');
          document.removeEventListener('keydown', onKey);
        }
        function onKey(e) { if (e.key === 'Escape') closeModal(); }

        // Chaque CTA : popup sur mobile, scroll vers le formulaire sur desktop.
        document.querySelectorAll('[data-lp-cta]').forEach(function (btn) {
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            if (mq.matches) {
              openModal();
            } else {
              region.scrollIntoView({ behavior: 'smooth', block: 'center' });
              setTimeout(function () { focusFirst(true); }, 450);
            }
          });
        });

        document.querySelectorAll('[data-lp-close]').forEach(function (el) {
          el.addEventListener('click', closeModal);
        });

        // Repasse en desktop → on s'assure que l'état "modal" est bien réinitialisé.
        mq.addEventListener('change', function () { if (!mq.matches) closeModal(); });

        // Header : fond au scroll (comme la page d'accueil)
        var header = document.getElementById('lp-header');
        if (header) {
          var onScroll = function () { header.classList.toggle('scrolled', window.scrollY > 8); };
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }
      })();
    </script>

