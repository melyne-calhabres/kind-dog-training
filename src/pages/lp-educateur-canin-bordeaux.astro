        background: var(--kd-white);
        border: 1px solid var(--kd-cream-deep);
        border-radius: var(--radius-pill);
        box-shadow: var(--shadow-xs);
        text-decoration: none;
        color: var(--kd-ink);
      }
      .lp-google-badge:hover { text-decoration: none; box-shadow: var(--shadow-sm); }
      .lp-google-badge__txt { font-size: var(--fs-sm); color: var(--kd-bark); }
      .lp-google-badge__txt strong { color: var(--kd-ink); }
      .lp-trust {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--sp-3);
      }
      .lp-trust li {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-3);
        font-size: var(--fs-md);
        font-weight: 600;
        color: var(--kd-bark);
      }
      .lp-trust svg { width: 18px; height: 18px; }
      .lp-trust svg { color: var(--kd-olive); flex-shrink: 0; }
      .lp-book-text {
        font-size: var(--fs-base);
        line-height: var(--lh-relaxed);
        color: var(--kd-bark);
        margin: 0;
      }
      .lp-book-cta { margin-top: var(--sp-2); }

      /* ─ Région formulaire : MOBILE = popup ─ */
      .lp-form-region {
        position: fixed;
        inset: 0;
        z-index: 300;
        display: none;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
      }
      .lp-form-region.is-open { display: block; }
      .lp-form-backdrop { position: fixed; inset: 0; background: rgba(42, 30, 21, 0.62); }
      .lp-form-panel {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 460px;
        margin: var(--sp-8) auto;
        background: var(--kd-paper);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        padding: var(--sp-6) var(--sp-5);
      }
      .lp-form-close {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        background: var(--kd-cream-warm);
        color: var(--kd-ink);
        border: none;
        border-radius: 50%;
        cursor: pointer;
      }
      .lp-form-close:hover { background: var(--kd-cream-deep); }
      .lp-form-head { margin-bottom: var(--sp-5); text-align: center; }
      .lp-form-reassure {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-2);
        font-size: var(--fs-sm);
        color: var(--kd-bark);
      }
      .lp-form-reassure__stars { color: #E8A33D; letter-spacing: 1px; }
      .lp-form-head p { font-size: var(--fs-sm); color: var(--kd-bark); margin: var(--sp-2) 0 0; }
      body.lp-modal-open { overflow: hidden; }

      /* ─ Lede générique ─ */
      .lp-lede {
        font-size: var(--fs-md);
        line-height: var(--lh-relaxed);
        color: var(--kd-bark);
        margin-bottom: var(--sp-6);
      }
      .lp-final .lp-lede { color: var(--kd-cream); }

      /* ─ Pain points ─ */
      .lp-pain { display: grid; gap: var(--sp-4); margin: var(--sp-8) 0; }
      .lp-pain li {
        display: flex;
        align-items: flex-start;
        gap: var(--sp-3);
        background: var(--kd-white);
        border: 1px solid var(--kd-cream-deep);
        border-radius: var(--radius-md);
        padding: var(--sp-4) var(--sp-5);
        font-size: var(--fs-base);
        color: var(--kd-ink);
      }
      .lp-pain svg { color: var(--kd-terracotta); flex-shrink: 0; margin-top: 3px; }

      /* ─ Tarifs récap (repris de la page tarifs) ─ */
      .lp-tarifs .recap-table-wrap {
        max-width: 800px;
        margin: var(--sp-8) auto 0;
        overflow-x: auto;
      }
      .recap-table { width: 100%; border-collapse: collapse; font-size: var(--fs-base); }
      .recap-table thead { background: var(--kd-ink); color: var(--kd-cream); }
      .recap-table th {
        padding: var(--sp-3) var(--sp-5);
        font-weight: 600;
        text-align: left;
        font-size: var(--fs-sm);
        letter-spacing: 0.02em;
      }
      .recap-table th:last-child { text-align: right; }
      .recap-table td {
        padding: var(--sp-3) var(--sp-5);
        color: var(--kd-bark);
        border-bottom: 1px solid var(--kd-stone);
        font-size: var(--fs-sm);
        line-height: var(--lh-relaxed);
      }
      .recap-table td:last-child { text-align: right; white-space: nowrap; }
      .recap-table tbody tr:hover { background: var(--kd-cream); }
      .recap-table strong { color: var(--kd-ink); font-weight: 700; }
      .recap-detail { color: var(--kd-fawn); font-size: var(--fs-xs); }
      .recap-footnote {
        text-align: center;
        font-size: 13px;
        color: var(--kd-fawn);
        font-style: italic;
        margin-top: var(--sp-4);
        max-width: 800px;
        margin-inline: auto;
      }

      /* ─ CTA final ─ */
      .lp-final { background: var(--kd-ink); color: var(--kd-cream); }
      .lp-final h2 { color: var(--kd-white); }

      /* ─ Footer ─ */
      .lp-footer {
        background: var(--kd-ink);
        color: var(--kd-stone);
        padding: var(--sp-6) 0;
        font-size: var(--fs-sm);
      }
      .lp-footer-inner {
        display: flex;
        flex-direction: column;
        gap: var(--sp-3);
        align-items: center;
        text-align: center;
      }
      .lp-footer-links { display: inline-flex; gap: var(--sp-5); }
      .lp-footer-links a { color: var(--kd-stone); }
      .lp-footer-links a:hover { color: var(--kd-terracotta-soft); }

      /* ─ Sticky mobile ─ */
      .lp-sticky {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 200;
        padding: 10px var(--sp-4) calc(10px + env(safe-area-inset-bottom));
        background: rgba(251, 246, 236, 0.96);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-top: 1px solid var(--kd-cream-deep);
      }
      .lp-sticky .btn { width: 100%; }

      @media (max-width: 767px) {
        body { padding-bottom: 80px; }
        .recap-table th, .recap-table td { padding: var(--sp-2) var(--sp-3); font-size: var(--fs-xs); }
        /* Sur mobile, un seul CTA (1re section) + barre sticky : on masque les autres */
        .lp-hide-mobile { display: none !important; }
        /* La liste de réassurance reste lisible et alignée à gauche */
        .lp-trust { align-self: center; }
        /* Moins d'espace en haut de la 1re section (elle suit directement le hero) */
        #lp-book { padding-top: var(--sp-6); }
      }

      /* ═══ DESKTOP (≥ 768px) ═══ */
      @media (min-width: 768px) {
        .lp-header-cta { display: inline-flex; }
        .lp-hero-brand { text-shadow: none; }

        /* Le logo (header sticky transparent) ne doit pas chevaucher le titre */
        .hero { padding-top: calc(var(--header-height) + var(--sp-10)); }

        /* 1re section : texte à gauche, formulaire à droite */
        .lp-book-inner {
          max-width: 1040px;
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: var(--sp-10);
          align-items: start;
        }
        .lp-book-lead { text-align: left; align-items: flex-start; }

        /* Le formulaire redevient un bloc inline (plus de popup), colonne de droite */
        .lp-form-region {
          position: static;
          display: block;
          overflow: visible;
          z-index: auto;
          margin-top: 0;
        }
        .lp-form-backdrop,
        .lp-form-close,
        .lp-form-head,
        .lp-book-cta { display: none; }
        .lp-form-panel {
          max-width: none;
          margin: 0;
          padding: 0;
          background: transparent;
          box-shadow: none;
        }

        .lp-sticky { display: none; }
      }
    </style>
  </body>
</html>
