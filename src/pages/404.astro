---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="Page introuvable — Kind Dog Training"
  description="La page que vous cherchez n'existe plus ou a changé d'adresse."
>
  <section class="not-found">
    <div class="container">
      <p class="not-found__code" aria-hidden="true">404</p>
      <h1 class="not-found__title">Cette page s'est barrée en balade</h1>
      <p class="lede not-found__lede">
        Elle a dû partir faire une promenade. La page que vous cherchez n'existe plus ou a changé d'adresse.
      </p>
      <div class="not-found__actions">
        <a href="/" class="btn btn-secondary">
          <Icon name="home" width={16} height={16} strokeWidth={2} />
          Retour à l'accueil
        </a>
        <a href="/prendre-rdv/" class="btn btn-primary">
          Prendre RDV
          <Icon name="calendar" width={16} height={16} strokeWidth={2} />
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    min-height: calc(100dvh - var(--header-height) - 200px);
    padding-block: var(--sp-24);
    text-align: center;
  }

  .not-found .container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .not-found__code {
    font-family: var(--font-serif);
    font-size: clamp(96px, 20vw, 180px);
    font-weight: 500;
    line-height: 1;
    color: var(--kd-terracotta);
    opacity: 0.18;
    margin-bottom: 0;
    letter-spacing: -0.04em;
    pointer-events: none;
    user-select: none;
  }

  .not-found__title {
    margin-top: calc(-1 * var(--sp-8));
    margin-bottom: var(--sp-5);
    font-size: clamp(var(--fs-2xl), 5vw, var(--fs-3xl));
  }

  .not-found__lede {
    max-width: 480px;
    margin-bottom: var(--sp-10);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    justify-content: center;
  }
</style>
