---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const packs = [
  {
    tag: 'Chiots/ados de 2 à 8 mois',
    title: 'Pack chiots & ados',
    subtitle: "Les bases d'un bon chien citoyen",
    image: '/images/pack-chiots.webp',
    imageAlt: 'Chiot staffie pendant une séance d\'éducation canine',
    sections: [
      {
        title: 'Objectifs :',
        items: [
          'Découverte du monde et socialisation (environnement, humains, chiens)',
          'Apprentissages du quotidien : propreté, solitude, destructions, mordillements, gestion des émotions',
          "Bases d'obéissance et de sécurité : assis, couché, pas bouger, au pied, marche en laisse, trottoir, traverse",
        ],
      },
      {
        title: 'Format :',
        items: [
          '8 séances individuelles personnalisées',
          'À domicile et/ou en extérieur selon vos besoins',
          'Suivi progressif adapté au chiot et à la famille',
        ],
        closing: 'Suivi WhatsApp 7j/7, bilan écrit à chaque séance, possibilité de me contacter à tout moment.',
      },
    ],
    sessions: '8 cours',
    price: '360 €',
    bilanOffert: true,
  },
  {
    tag: 'Chiens de 8 mois et +',
    title: 'Pack chiens adultes',
    subtitle: 'pour les chiens qui ont séché quelques leçons',
    image: '/images/pack-adultes.webp',
    imageAlt: 'Chien cocker anglais pendant une séance d\'éducation canine',
    imagePosition: 'center 30%',
    sections: [
      {
        title: 'Pour traiter les cas tels que :',
        items: [
          "Gestion de l'accueil des invités (sauts, aboiements, excitation excessive)",
          'Travail approfondi sur les émotions : frustrations, renoncement, auto-contrôle',
          'Gestion des croisements avec les autres chiens : calme, renoncement, auto-contrôle',
          "Amélioration de la marche en laisse : tension, traction, attention sur le propriétaire",
          "Retravailler l'obéissance globale",
        ],
        closing: 'Suivi WhatsApp 7j/7, bilan écrit à chaque séance, possibilité de me contacter à tout moment.',
      },
    ],
    sessions: '5 cours',
    price: '230 €',
    bilanOffert: true,
  },
  {
    tag: 'Chiots ou chiens adultes',
    title: 'Pack chien réactif/agressif',
    subtitle: 'pour les chiens en plus grande difficulté',
    image: '/images/pack-reactif.webp',
    imageAlt: 'Chien réactif pendant un travail de désensibilisation',
    imagePosition: 'center 30%',
    intro: "Pour les chiens présentant de l'agressivité envers les autres chiens.",
    sections: [
      {
        title: 'Objectifs :',
        items: [
          'Gestion de la réactivité au quotidien (croisements, balades, anticipation, gestion de l\'environnement)',
          'Travail approfondi sur les émotions : frustration, renoncement, auto-contrôle',
          'Renforcement de la relation avec le propriétaire : focus, communication, sécurité émotionnelle',
          'Travail progressif et adapté sur les déclencheurs spécifiques du chien',
        ],
        note: "Ce pack vise à poser les bases, sécuriser le quotidien et initier un changement durable. Le nombre de séance peut ne pas suffire dans certains cas, cela se définit lors du bilan comportemental de votre chien.",
      },
      {
        title: 'Format :',
        items: [
          '5 séances individuelles personnalisées',
          'À domicile et/ou en extérieur selon vos besoins',
          'Adaptation du rythme au chien et à ses capacités émotionnelles',
          'Pack renouvelable si nécessaire',
        ],
        closing: 'Suivi WhatsApp 7j/7, bilan écrit à chaque séance, possibilité de me contacter à tout moment.',
      },
    ],
    sessions: '5 cours',
    price: '230 €',
    bilanOffert: true,
  },
  {
    tag: "À l'unité",
    title: 'Cours individuels',
    subtitle: 'pour ceux qui préfèrent la simplicité',
    image: '/images/chien-shiba.webp',
    imageAlt: 'Éducation d\'un chien Shiba Inu à Bordeaux',
    imagePosition: 'center 15%',
    blurb: `Si les packs de plusieurs cours ne sont pas adaptés à votre situation, vous avez la possibilité de prendre des <a href="/services/cours-individuel-education-canine-bordeaux/" class="pricing-blurb-link">cours individuels</a> à l'unité. Peu importe votre problème et votre situation, nous trouverons toujours une solution qui conviendra à votre chien.`,
    sessions: '1 cours',
    price: '50 €',
    bilanOffert: true,
  },
];

const specialFormats = [
  {
    title: 'Cours collectifs',
    subtitle: 'apprendre ensemble dans un cadre convivial',
    image: '/images/cours-collectifs.webp',
    imageAlt: 'Cours collectifs d\'éducation canine avec Kind Dog Training',
    imagePosition: 'center 70%',
    description: "Travaillez en groupe avec d'autres propriétaires et leurs chiens. Idéal pour travailler l'obéissance en présence de distractions et profiter d'un cadre de socialisation stimulant.\n\nJe constitue toujours les groupes de manière précise afin de répondre aux différents besoins de chacun et d'être sûr que tout le monde s'entende bien. Les <a href=\"/services/cours-collectifs/\">cours collectifs</a> sont composés de maximum 6 chiens.",
    sessions: '1 séance collective',
    price: '30 €',
    priceDetail: '/chien',
  },
  {
    title: 'Stages de plusieurs jours',
    subtitle: 'pour progresser rapidement et en profondeur',
    description: "Vous souhaitez un accompagnement intensif sur plusieurs jours consécutifs ? Les stages permettent de travailler en profondeur sur une problématique spécifique. Programme 100 % personnalisé selon votre chien et vos objectifs. Ce format est particulièrement adapté pour les personnes qui souhaitent travailler avec moi mais qui ne résident pas sur Bordeaux.\n\nLe prix et le format exact peuvent grandement varier d'un chien à un autre en fonction de votre situation. Prenez contact avec moi afin que nous puissions échanger et établir la meilleure stratégie pour vous.",
    sessions: 'Durée à définir ensemble',
    price: 'Sur devis',
  },
];

const faqItems = [
  {
    question: "Le bilan comportemental est-il payant ?",
    answer: "Le bilan comportemental est gratuit à votre domicile si vous êtes dans un rayon de 20 km. Au-delà, un forfait de 20 € s'applique pour les frais de déplacement."
  },
  {
    question: "Quels moyens de paiement acceptez-vous ?",
    answer: "J'accepte les paiements par virement bancaire/Paypal/Wero, chèque et espèces. Le paiement en plusieurs fois est possible pour les packs."
  },
  {
    question: "Que se passe-t-il si je dois annuler/déplacer un cours ?",
    answer: "Toute annulation ou déplacement est possible sans frais."
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout
  title="Quel Tarif pour un Educateur Canin à Bordeaux ?"
  description="Tarifs éducateur canin à Bordeaux : bilan gratuit, pack chiots 360 €, pack adultes 230 €, pack réactif 230 €, cours individuel 50 €. Toutes races."
  canonicalUrl="/tarif-educateur-canin-bordeaux"
  preloadImages={[
    { href: '/images/hero-tarifs-mobile-photo.webp', media: '(max-width: 767px)' },
    { href: '/images/hero-tarifs-desktop-photo.webp', media: '(min-width: 768px)' },
  ]}
>
  <!-- HERO -->
  <section class="hero hero--tarifs" aria-labelledby="hero-tarifs-heading">
    <div class="container">
      <div class="hero-content">
        <h1 id="hero-tarifs-heading">Les tarifs de <span class="accent">Kind Dog Training</span></h1>
        <p class="hero-subtitle">
          Découvrez les tarifs de mes cours d'éducation canine à Bordeaux et ses alentours.
        </p>
      </div>
    </div>
  </section>

  <!-- BILAN CALLOUT -->
  <section class="tarifs-notice">
    <div class="container">
      <div class="tarifs-notice__card">
        <p class="tarifs-notice__title">⚠️ Important à savoir !</p>
        <p>Chaque accompagnement, et ce quelle que soit votre situation, débute toujours par un <a href="/services/bilan-comportemental/" class="tarifs-notice__link">bilan comportemental</a> à votre domicile entièrement <strong>GRATUIT</strong> (20&nbsp;€ si &gt;20&nbsp;km).</p>
        <p>Ce bilan a pour but de faire un état des lieux de votre situation, des problèmes que vous rencontrez et de l'historique de votre chien. Nous allons donc avoir une discussion autour de ces sujets afin d'établir par la suite un plan d'action.</p>
        <p>Le but premier de Kind Dog Training est de vous aider et d'aider votre chien, pas de vous faire perdre votre temps et votre argent. Si vous êtes satisfait de ce bilan comportemental alors nous pourrons planifier un premier cours. Sinon, vous n'aurez rien perdu.</p>
      </div>
    </div>
  </section>

  <!-- TABLEAU RÉCAPITULATIF -->
  <section class="tarifs-recap" aria-labelledby="recap-heading">
    <div class="container">
      <h2 id="recap-heading" class="recap-title">Récapitulatif des <span class="accent">tarifs</span></h2>
      <div class="recap-table-wrap">
        <table class="recap-table">
          <thead>
            <tr>
              <th>Prestation</th>
              <th>Séances</th>
              <th>Tarif</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Bilan comportemental</td>
              <td>1 séance</td>
              <td><strong>Gratuit*</strong></td>
            </tr>
            <tr>
              <td>Pack chiots & ados <span class="recap-detail">(2 à 8 mois)</span></td>
              <td>8 cours</td>
              <td><strong>360 €</strong></td>
            </tr>
            <tr>
              <td>Pack chiens adultes <span class="recap-detail">(8 mois et +)</span></td>
              <td>5 cours</td>
              <td><strong>230 €</strong></td>
            </tr>
            <tr>
              <td>Pack chien réactif/agressif</td>
              <td>5 cours</td>
              <td><strong>230 €</strong></td>
            </tr>
            <tr>
              <td>Cours individuel</td>
              <td>1 cours</td>
              <td><strong>50 €</strong></td>
            </tr>
            <tr>
              <td>Cours collectif</td>
              <td>1 cours</td>
              <td><strong>30 €</strong><span class="recap-detail">/chien</span></td>
            </tr>
            <tr>
              <td>Stage de plusieurs jours</td>
              <td>À définir</td>
              <td><strong>Sur devis</strong></td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="recap-footnote">* Gratuit dans un rayon de 20 km, 20 € au-delà.</p>
      <div class="recap-cta-wrap">
        <a href="#details-tarifs" class="recap-cta">
          Voir les détails plus bas
          <Icon name="arrow-down" width={14} height={14} strokeWidth={1.75} />
        </a>
      </div>
    </div>
  </section>

  <!-- WAVE: white → cream-warm -->
  <div class="wave-separator wave-separator--from-white" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 80" preserveAspectRatio="none">
      <path fill="#EFE3CB" d="M0,40 C360,0 1080,80 1440,40 L1440,80 L0,80 Z"/>
    </svg>
  </div>

  <!-- POURQUOI KIND DOG -->
  <section class="why-kdt-section" aria-labelledby="why-kdt-heading">
    <div class="container">
      <div class="why-kdt-layout">
        <h2 id="why-kdt-heading" class="why-kdt-title">Pourquoi choisir <span class="accent">Kind Dog Training</span>&nbsp;?</h2>
        <div class="why-kdt-image-wrap">
          <img
            src="/images/why-kind-dog.webp"
            alt="Mélyne, éducatrice canin à Bordeaux et son chien Ramsey"
            class="why-kdt-img"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="why-kdt-text">
          <p class="why-kdt-intro"><em>(Chacune de ces situations a malheureusement déjà été rencontrée par les personnes que j'accompagne)</em></p>
          <ul class="why-kdt-list">
            <li>Parce que la transparence et l'humilité sont au centre de mon accompagnement.</li>
            <li>Je travaille avec tous types de chiens, toutes races (oui vraiment, je ne vous refuserai pas avec une fausse excuse sous prétexte que vous avez un Staff, Malinois, Rott, etc...).</li>
            <li>Je n'utilise aucune méthode douteuse ni aucun outil qui pourrait blesser physiquement votre chien.</li>
            <li>Je ne conclurai jamais un accompagnement en vous disant «&nbsp;c'est un &lt;insérer le nom d'une race&gt;, il sera toujours comme ça&nbsp;». Vous venez car vous avez un problème, alors on règle le problème.</li>
            <li>Je ne vous conseillerai jamais de médicamenter votre chien (c'est le travail d'un vétérinaire).</li>
            <li>Je ne vous conseillerai jamais de déménager sous prétexte que votre environnement ne convient pas à votre chien (on travaille autour du problème, on ne le fuit pas).</li>
            <li>Je ne vous ferai pas payer un cours pour vous apprendre à tenir une longe.</li>
            <li>Je m'adapte à <strong>VOTRE</strong> situation et <strong>VOTRE</strong> quotidien. La méthode de travail et les exercices que je propose doivent pouvoir s'intégrer dans votre rythme de vie, pas l'inverse.</li>
            <li>Votre chien sera toujours très content de me voir (oui oui vous verrez).</li>
          </ul>
          <p class="why-kdt-closing">Chaque cours, chaque échange, chaque interaction sera fait de manière respectueuse pour votre chien.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WAVE: cream-warm → white -->
  <div class="wave-separator wave-separator--from-warm" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 80" preserveAspectRatio="none">
      <path fill="#FFFFFF" d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z"/>
    </svg>
  </div>

  <!-- PRICING -->
  <section class="section pricing-section" id="details-tarifs" style="padding-top: var(--sp-8);">
    <div class="container">
      <div class="pricing-grid">
        {packs.map((pack) => (
          <article class="card pricing-card">
            <p class="pricing-tag">{pack.tag}</p>
            <header>
              <h2 class="pricing-title">{pack.title}</h2>
              <p class="pricing-subtitle">{pack.subtitle}</p>
            </header>
            {pack.image && (
              <img
                src={pack.image}
                alt={pack.imageAlt ?? pack.title}
                class="pricing-card-img"
                loading="lazy"
                decoding="async"
                style={pack.imagePosition ? `object-position: ${pack.imagePosition}` : undefined}
              />
            )}
            {pack.sections ? (
              <div class="pricing-desc">
                {pack.intro && <p class="pricing-desc-intro">{pack.intro}</p>}
                {pack.sections.map((section) => (
                  <div class="pricing-desc-block">
                    <p class="pricing-desc-section-title">{section.title}</p>
                    <ul class="pricing-desc-list">
                      {section.items.map((item) => <li>{item}</li>)}
                    </ul>
                    {section.note && <p class="pricing-desc-note">{section.note}</p>}
                    {section.closing && <p class="pricing-desc-closing">{section.closing}</p>}
                  </div>
                ))}
              </div>
            ) : (
              <p class="pricing-desc" set:html={pack.blurb} />
            )}
            {pack.bilanOffert && (
              <p class="pricing-bilan">Bilan comportemental <strong>OFFERT</strong></p>
            )}
            <footer class="pricing-footer">
              <span class="pricing-sessions">{pack.sessions}</span>
              <data class="pricing-price" value={pack.price.replace(/\s/g, '').replace('€', '')}>{pack.price}</data>
            </footer>
            <a href="/prendre-rdv/" class="pricing-cta">
              Prendre RDV
              <Icon name="arrow-right" width={14} height={14} strokeWidth={1.75} />
            </a>
          </article>
        ))}
      </div>

      <p style="margin-top: var(--sp-8); font-size: 13px; color: var(--kd-fawn); font-style: italic; text-align: center;">
        * Bilan comportemental à 20 € si > 20 km. Suivi WhatsApp 7j/7 et bilan écrit inclus dans tous les packs.
      </p>

      <div class="special-formats-grid">
        {specialFormats.map((format) => (
          <article class="card special-format-card">
            <header>
              <h2 class="pricing-title">{format.title}</h2>
              <p class="pricing-subtitle">{format.subtitle}</p>
            </header>
            {format.image && (
              <img
                src={format.image}
                alt={format.imageAlt ?? format.title}
                class="pricing-card-img"
                loading="lazy"
                decoding="async"
                style={format.imagePosition ? `object-position: ${format.imagePosition}` : undefined}
              />
            )}
            <div class="pricing-desc special-format-desc">
              {format.description.split('\n\n').map((para) => (
                <p set:html={para} />
              ))}
            </div>
            <footer class="pricing-footer">
              <span class="pricing-sessions">{format.sessions}</span>
              <span class="pricing-price">
                {format.price}
                {format.priceDetail && <span class="pricing-price-detail">{format.priceDetail}</span>}
              </span>
            </footer>
            <a href="/prendre-rdv/" class="pricing-cta">
              {format.price === 'Sur devis' ? 'Demander un devis' : 'Prendre RDV'}
              <Icon name="arrow-right" width={14} height={14} strokeWidth={1.75} />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq" aria-labelledby="faq-heading">
    <div class="container" style="max-width: 750px;">
      <h2 style="text-align: center;">Questions sur les <span class="accent">tarifs</span></h2>
      <div class="faq-list" style="margin-top: var(--sp-8);">
        {faqItems.map((item) => (
          <details class="faq-item">
            <summary class="faq-question">
              {item.question}
              <svg class="faq-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="faq-answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</Layout>

<style>
  /* Bilan callout */
  .tarifs-notice {
    background: var(--kd-white);
    padding-block: var(--sp-12);
  }

  .tarifs-notice__card {
    background: var(--kd-ink);
    color: var(--kd-cream);
    border-radius: var(--radius-lg);
    padding: var(--sp-8) var(--sp-10);
    max-width: 860px;
    margin-inline: auto;
    text-align: center;
    box-shadow: var(--shadow-lg);
  }

  .tarifs-notice__card p:not(.tarifs-notice__title) {
    font-size: var(--fs-base);
    line-height: var(--lh-relaxed);
    color: var(--kd-stone);
    margin-bottom: var(--sp-4);
  }

  .tarifs-notice__card p:not(.tarifs-notice__title):last-child {
    margin-bottom: 0;
  }

  .tarifs-notice__card strong {
    color: var(--kd-cream);
  }

  .tarifs-notice__link {
    color: var(--kd-cream);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tarifs-notice__link:hover {
    opacity: 0.8;
  }

  .pricing-blurb-link {
    color: var(--kd-terracotta);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pricing-blurb-link:hover {
    opacity: 0.75;
  }

  .tarifs-notice__title {
    font-family: var(--font-serif);
    font-size: clamp(36px, 3.5vw, 48px);
    font-weight: 500;
    color: var(--kd-cream);
    margin-bottom: var(--sp-5);
    line-height: var(--lh-snug);
  }

  @media (min-width: 768px) {
    .tarifs-notice {
      padding-top: 24px;
    }

    .tarifs-notice__card {
      max-width: 1100px;
    }
  }

  @media (max-width: 767px) {
    .tarifs-notice__card {
      padding: var(--sp-6);
    }

    .tarifs-notice__title {
      font-size: 28px;
    }
  }

  /* Recap table */
  .tarifs-recap {
    background: var(--kd-white);
    padding-block: var(--sp-10) var(--sp-12);
  }

  .recap-title {
    text-align: center;
    margin-bottom: var(--sp-8);
  }

  .recap-table-wrap {
    max-width: 800px;
    margin-inline: auto;
    overflow-x: auto;
  }

  .recap-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-base);
  }

  .recap-table thead {
    background: var(--kd-ink);
    color: var(--kd-cream);
  }

  .recap-table th {
    padding: var(--sp-3) var(--sp-5);
    font-weight: 600;
    text-align: left;
    font-size: var(--fs-sm);
    letter-spacing: 0.02em;
  }

  .recap-table th:last-child {
    text-align: right;
  }

  .recap-table td {
    padding: var(--sp-3) var(--sp-5);
    color: var(--kd-bark);
    border-bottom: 1px solid var(--kd-stone);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
  }

  .recap-table td:last-child {
    text-align: right;
    white-space: nowrap;
  }

  .recap-table tbody tr:hover {
    background: var(--kd-cream);
  }

  .recap-table strong {
    color: var(--kd-ink);
    font-weight: 700;
  }

  .recap-detail {
    color: var(--kd-fawn);
    font-size: var(--fs-xs);
  }

  .recap-footnote {
    text-align: center;
    font-size: 13px;
    color: var(--kd-fawn);
    font-style: italic;
    margin-top: var(--sp-4);
    max-width: 800px;
    margin-inline: auto;
  }

  .recap-cta-wrap {
    text-align: center;
    margin-top: var(--sp-6);
  }

  .recap-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--kd-terracotta);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .recap-cta:hover {
    opacity: 0.75;
  }

  @media (max-width: 767px) {
    .tarifs-recap {
      padding-block: var(--sp-8) var(--sp-10);
    }

    .recap-table th,
    .recap-table td {
      padding: var(--sp-2) var(--sp-3);
      font-size: var(--fs-xs);
    }
  }

  /* Wave variants */
  .wave-separator--from-white {
    background-color: var(--kd-white);
  }

