            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────────────── -->
  <section class="section-dark ec-cta-section" aria-labelledby="ec-cta-h">
    <div class="container ec-cta-inner">
      <h2 class="ec-cta-title" id="ec-cta-h">Besoin d'aide face à un problème de comportement&nbsp;?</h2>
