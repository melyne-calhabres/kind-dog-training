  ],
};

// ── TL;DR — L'essentiel ───────────────────────────────────────────────────────
const tldr = [
  'L\'anxiété de séparation du chien n\'est pas toujours ce qu\'on croit : elle se confond souvent avec l\'hyperattachement, l\'ennui ou un chien qui surveille simplement vos allées et venues. Le moteur n\'est pas le même et le travail non plus',
  'Un chien qui détruit, qui fait ses besoins ou qui vocalise en votre absence vous envoie une information. La détresse commence souvent bien avant que vous ne franchissiez la porte',
  'Les clés, les chaussures et le manteau annoncent votre départ. Les manipuler à froid, sans partir, casse cette anticipation qui fait monter votre chien en pression',
  'Réapprendre l\'autonomie passe par le quotidien : refuser certaines sollicitations, empêcher le suivi de pièce en pièce, faire du panier un point de calme',
  'Les absences se travaillent minute par minute, à partir du seuil précis où votre chien commence à craquer',
  'La cage aggrave souvent la détresse au lieu de la calmer. Revenir parce qu\'il aboie ancre le problème un peu plus',
  'Un chien adulte ou âgé peut progresser. Ce n\'est jamais joué d\'avance',
];

// ── Table of contents ─────────────────────────────────────────────────────────
const toc = [
  { label: 'Vraie anxiété, hyperattachement ou manque de cadre ?', href: '#vraie-anxiete-hyperattachement-manque-cadre', sub: false },
  { label: 'Dépendance du foyer vs mauvais démarrage',            href: '#dependance-foyer-mauvais-demarrage',            sub: true  },
  { label: 'Quand ce n\'est pas de l\'anxiété',                   href: '#ennui-ou-controle',                             sub: true  },
  { label: 'Casser les rituels de départ',                        href: '#casser-rituels-depart',                         sub: false },
  { label: 'Pourquoi les clés font monter en angoisse',           href: '#cles-chaussures-manteau',                       sub: true  },
  { label: 'Manipuler ces objets sans partir',                    href: '#manipuler-sans-partir',                         sub: true  },
  { label: 'Réapprendre l\'autonomie au quotidien',               href: '#reapprendre-autonomie',                         sub: false },
  { label: 'Refuser certaines sollicitations',                    href: '#refuser-sollicitations',                        sub: true  },
  { label: 'L\'empêcher de vous suivre de pièce en pièce',        href: '#empecher-suivre-piece',                         sub: true  },
  { label: 'Le panier comme point de calme',                      href: '#panier-point-calme',                            sub: true  },
  { label: 'Travailler les absences progressivement',             href: '#travailler-absences-progressivement',           sub: false },
  { label: 'Trouver le seuil de votre chien',                     href: '#trouver-le-seuil',                              sub: true  },
  { label: 'Dépense, flair et jouet de solitude',                 href: '#depense-flair-jouet-solitude',                  sub: true  },
  { label: 'Allonger minute par minute',                          href: '#allonger-minute-par-minute',                    sub: true  },
  { label: 'Les erreurs qui aggravent l\'anxiété',                href: '#erreurs-aggravent-anxiete',                     sub: false },
  { label: 'La cage amplifie la détresse',                        href: '#cage-amplifie-detresse',                        sub: true  },
  { label: 'Revenir parce qu\'il aboie',                          href: '#revenir-parce-quil-aboie',                      sub: true  },
  { label: 'Les signes qui ne trompent pas',                      href: '#signes-anxiete-separation',                     sub: false },
  { label: 'Ce que vous retrouvez en rentrant',                   href: '#ce-que-vous-retrouvez',                         sub: true  },
  { label: 'Ce que les voisins entendent',                        href: '#ce-que-les-voisins-entendent',                  sub: true  },
  { label: 'Le chien qui vous colle avant le départ',             href: '#chien-qui-vous-colle',                          sub: true  },
];

// ── Articles connexes ─────────────────────────────────────────────────────────
const related = [
  {
    title:    'Mon chien est réactif aux autres chiens en balade',
    readTime: '13 min',
    img:      '/images/article-reactivite-chiens.webp',
    imgAlt:   'Chien réactif tenu en laisse face à un autre chien pendant une promenade',
    url:      '/education-canine/comportement/problemes/reactivite/chiens/',
  },
  {
    title:    'Adolescence du chien : les fausses croyances',
    readTime: '15 min',
