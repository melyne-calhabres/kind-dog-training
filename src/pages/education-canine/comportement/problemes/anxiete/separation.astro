import ArticleProgressBar from '../../../../../components/ArticleProgressBar.astro';
import '../../../../../styles/services.css';
import '../../../../../styles/article.css';

// ── Page SEO ──────────────────────────────────────────────────────────────────
const page = {
  metaTitle:       'Anxiété de Séparation du Chien : Que Faire Concrètement ?',
  metaDescription: 'Votre chien fait de l\'Anxiété de Séparation ? Identifiez le vrai problème, découvrez comment casser les rituels de départ et travailler les absences minute par minute pour l\'apaiser.',
};

// ── Article metadata ──────────────────────────────────────────────────────────
const article = {
  category:       'Comportement',
  categoryUrl:    '/education-canine/comportement/',
  parentLabel:    'Problèmes',
  parentUrl:      '/education-canine/comportement/problemes/',
  breadcrumbLabel:'Anxiété de séparation',
  titleBefore:    '',
  titleAccent:    'Anxiété de séparation',
  titleAfter:     ' chez le chien : que faire concrètement ?',
  publishDate:    '4 juillet 2026',
  publishDateIso: '2026-07-04',
  readTime:       '16 min',
  author:         'Mélyne',
  authorInitial:  'M',
  authorRole:     'Éducatrice & comportementaliste canin · Bordeaux',
  authorDesc:     'Passionnée par la relation entre l\'humain et le chien, j\'accompagne les propriétaires dans l\'éducation et la rééducation de leur chien, quelle que soit la problématique.',
  coverAlt:       'Chien couché seul près de la porte d\'entrée, en attente du retour de ses propriétaires',
};

// ── FAQ ───────────────────────────────────────────────────────────────────────
const faqItems: { question: string; answer: string }[] = [
  {
    question: 'Combien de temps faut-il pour qu\'un chien apprenne à rester seul ?',
    answer:   'Il n\'y a pas de durée universelle, parce que tout dépend du point de départ et de la régularité du travail. Un chien avec de bonnes bases de détachement progresse en quelques semaines. Un chien profondément dépendant, ou parti d\'un mauvais démarrage de vie, demandera peut-être plus de temps. Ce qui compte le plus, c\'est la constance : le protocole (casser les rituels, refuser certaines sollicitations, travailler les absences minute par minute) doit être appliqué tous les jours pour créer de vrais automatismes émotionnels. Un travail régulier sur des tranches courtes bat toujours une grosse session par semaine. La contrainte de vos horaires peut ralentir le rythme, mais elle n\'empêche pas la progression.',
  },
  {
    question: 'Mon chien détruit tout quand je pars : est-ce forcément de l\'anxiété ?',
    answer:   'Non, et c\'est une confusion fréquente. La destruction peut venir de l\'anxiété de séparation mais aussi de l\'ennui, d\'un besoin de mâcher non satisfait, ou d\'un manque de dépense. L\'indice le plus utile : ce que votre chien détruit. S\'il cible ce qui porte votre odeur, l\'anxiété est probable. S\'il s\'attaque à tout et n\'importe quoi, un manque d\'occupation et de dépense entre souvent en jeu. Un chien jeune, en pleine énergie, laissé seul sans avoir été sorti ni stimulé, va chercher à s\'occuper comme il peut. Avant de conclure à l\'anxiété, posez-vous la question des besoins comblés : balade, mastication, travail mental.',
  },
  {
    question: 'Peut-on encore agir sur un chien adulte ou âgé ?',
    answer:   'Oui. L\'idée qu\'un chien adulte serait « fait » et qu\'on ne pourrait plus rien changer est fausse. Le travail peut demander un peu plus de patience, parce qu\'il faut défaire des habitudes installées depuis longtemps, mais le cerveau du chien reste capable d\'apprendre à tout âge. J\'accompagne régulièrement des chiens qui ont développé de l\'anxiété de séparation tard, souvent après un changement de vie : déménagement, stérilisation, retour au travail après une longue période de présence. La cause est rarement une fatalité liée à l\'âge, c\'est presque toujours un contexte qui a basculé. Et un contexte, ça se retravaille.',
  },
];

// ── JSON-LD structured data ───────────────────────────────────────────────────
const siteUrl = Astro.site?.origin ?? 'https://kind-dog-training.fr';
const pageUrl  = Astro.url.href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type':       'Article',
      headline:      article.titleBefore + article.titleAccent + article.titleAfter,
      description:   page.metaDescription,
      datePublished: '2026-07-04T09:00:00+02:00',
      dateModified:  '2026-07-04T09:00:00+02:00',
      inLanguage:    'fr-FR',
      url:           pageUrl,
      image: {
        '@type':  'ImageObject',
        url:      siteUrl + '/images/article-anxiete-separation-chien.webp',
        width:    925,
        height:   456,
      },
      author: {
        '@type':    'Person',
        name:       article.author,
        url:        siteUrl + '/qui-suis-je/',
        jobTitle:   'Éducatrice & comportementaliste canin',
        description: article.authorDesc,
      },
      publisher: {
        '@type': 'Organization',
        name:    'Kind Dog Training',
        url:     siteUrl,
        logo: {
          '@type': 'ImageObject',
          url:     siteUrl + '/images/logo.png',
        },
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id':   pageUrl,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil',                    item: siteUrl + '/' },
        { '@type': 'ListItem', position: 2, name: article.category,             item: siteUrl + article.categoryUrl },
        { '@type': 'ListItem', position: 3, name: article.parentLabel,          item: siteUrl + article.parentUrl },
        { '@type': 'ListItem', position: 4, name: article.breadcrumbLabel },
      ],
    },
    ...(faqItems.length > 0
      ? [{
          '@type': 'FAQPage',
