  <script is:inline>
    (function () {
      var MIN_CHARS = 10;
      var feedbackWrap = document.getElementById('art-feedback');
      var likeBtn = document.getElementById('art-like-btn');
      var dislikeBtn = document.getElementById('art-dislike-btn');
      var feedbackForm = document.getElementById('art-feedback-form');
      var feedbackText = document.getElementById('art-feedback-text');
      var feedbackHint = document.getElementById('art-feedback-hint');
      var feedbackSubmit = document.getElementById('art-feedback-submit');
      var feedbackThanks = document.getElementById('art-feedback-thanks');

      if (!feedbackWrap || !likeBtn || !dislikeBtn) return;

      function sendGA4Event(eventName, params) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(Object.assign({ event: eventName }, params));
      }

      function getArticleTitle() {
        var h1 = document.querySelector('h1');
        return h1 ? h1.textContent.trim() : document.title;
      }

      function showThanks() {
        feedbackWrap.querySelectorAll('.art-feedback-buttons, .art-feedback-form, .art-feedback-question').forEach(
          function (el) { el.hidden = true; }
        );
        feedbackThanks.hidden = false;
      }

      likeBtn.addEventListener('click', function () {
        sendGA4Event('article_like', {
          page_url: window.location.href,
          article_title: getArticleTitle(),
        });
        showThanks();
      });

      dislikeBtn.addEventListener('click', function () {
        likeBtn.hidden = true;
        dislikeBtn.classList.add('art-feedback-btn--selected');
        dislikeBtn.disabled = true;
        feedbackForm.hidden = false;
        feedbackText.focus();
      });

      feedbackText.addEventListener('input', function () {
        var len = feedbackText.value.trim().length;
        var valid = len >= MIN_CHARS;
        feedbackSubmit.disabled = !valid;
        if (len === 0) {
          feedbackHint.textContent = MIN_CHARS + ' caractères minimum';
          feedbackHint.classList.remove('art-feedback-hint--ok');
        } else if (!valid) {
          feedbackHint.textContent = 'Encore ' + (MIN_CHARS - len) + ' caractère' + (MIN_CHARS - len > 1 ? 's' : '');
          feedbackHint.classList.remove('art-feedback-hint--ok');
        } else {
          feedbackHint.textContent = 'Prêt à envoyer';
          feedbackHint.classList.add('art-feedback-hint--ok');
        }
      });

      feedbackSubmit.addEventListener('click', function () {
        var text = feedbackText.value.trim();
        if (text.length < MIN_CHARS) return;
        sendGA4Event('article_dislike', {
          page_url: window.location.href,
          article_title: getArticleTitle(),
          user_feedback: text,
        });
        showThanks();
      });
    })();
  </script>

  <script>
    const btn = document.getElementById('art-copy-link');
    if (btn) {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
        } catch {
          const el = Object.assign(document.createElement('input'), { value: window.location.href });
          document.body.appendChild(el);
          el.select();
          document.execCommand('copy');
          el.remove();
        }
        btn.setAttribute('data-copied', '');
        setTimeout(() => btn.removeAttribute('data-copied'), 2000);
      });
    }
  </script>

