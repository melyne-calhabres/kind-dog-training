  { label: 'Les deux réflexes qui nourrissent la surexcitation', href: '#reflexes-balade',      sub: false },
  { label: 'Autoriser tous les contacts',                 href: '#autoriser-tous-contacts',     sub: true  },
  { label: 'Figer la situation en cas de croisement',     href: '#figer-situation',             sub: true  },
  { label: 'Le matériel qui aide ou qui sabote',          href: '#materiel',                    sub: false },
  { label: 'La longe : liberté sous contrôle',            href: '#longe-liberte',               sub: true  },
  { label: 'Le mensonge du harnais anti-traction',        href: '#harnais-anti-traction',       sub: true  },
  { label: 'Bannir la laisse enrouleuse',                 href: '#laisse-enrouleuse',           sub: true  },
  { label: 'Le code matériel-contexte',                   href: '#code-materiel',               sub: true  },
  { label: 'Transférer le renoncement en balade',         href: '#renoncement',                 sub: false },
  { label: '« Pas bouger » face à la balle, en extérieur', href: '#pas-bouger',                 sub: true  },
  { label: 'Le rappel en pleine course',                  href: '#rappel-course',               sub: true  },
  { label: 'Face à un stimulus qui le fait vriller',      href: '#stimulus-vriller',            sub: true  },
  { label: 'Chaque type de déclencheur a sa lecture',     href: '#declencheurs',                sub: false },
  { label: 'Installer le calme en extérieur',             href: '#installer-calme',             sub: false },
  { label: 'Observer le monde sans y réagir',             href: '#observer-sans-reagir',        sub: true  },
  { label: 'Le couché en balade comme point d\'ancrage',  href: '#couche-ancrage',              sub: true  },
  { label: 'Le focus : capter le regard',                 href: '#focus-regard',                sub: true  },
  { label: 'La décompression au retour de balade',        href: '#decompression',               sub: false },
  { label: 'Votre état émotionnel régule le sien',        href: '#etat-emotionnel-maitre',      sub: false },
