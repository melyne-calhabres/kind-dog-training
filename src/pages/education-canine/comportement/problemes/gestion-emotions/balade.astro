---
import Layout from '../../../../../layouts/Layout.astro';
import Icon from '../../../../../components/Icon.astro';
import ArticleProgressBar from '../../../../../components/ArticleProgressBar.astro';
import ExperienceTerrain from '../../../../../components/ExperienceTerrain.astro';
import { pickRandomArticles } from '../../../../../utils/pickRandomArticles';
import { getAuthorPerson, getPublisherOrganization } from '../../../../../data/author';
import '../../../../../styles/services.css';
import '../../../../../styles/article.css';

// ── Page SEO ──────────────────────────────────────────────────────────────────
const page = {
  metaTitle:       'Mon Chien a du Mal à Gérer ses Émotions en Balade : Que Faire',
  metaDescription: 'Votre chien déborde en balade ? Comprenez ce qui se joue, changez vos réflexes et apprenez-lui à monter puis à redescendre en excitation.',
};

// ── Article metadata ──────────────────────────────────────────────────────────
const article = {
  category:       'Comportement',
  categoryUrl:    '/education-canine/comportement/',
  parentLabel:    'Problèmes',
  parentUrl:      '/education-canine/comportement/problemes/',
  hubLabel:       'Gérer ses émotions',
  hubUrl:         '/education-canine/comportement/problemes/gestion-emotions/',
  breadcrumbLabel:'Gérer ses émotions en balade',
  titleBefore:    'Mon chien a du mal à ',
  titleAccent:    'gérer ses émotions en balade',
  titleAfter:     ' : comprendre et reprendre la main',
  publishDate:    '26 juin 2026',
  publishDateIso: '2026-06-26',
  updateDate:     '18 septembre 2026',
  updateDateIso:  '2026-09-18',
  readTime:       '25 min',
  author:         'Mélyne',
  authorRole:     'Éducatrice & comportementaliste canin · Bordeaux',
  authorDesc:     'Passionnée par la relation entre l\'humain et le chien, j\'accompagne les propriétaires dans l\'éducation et la rééducation de leur chien, quelle que soit la problématique.',
  coverAlt:       'Chien en balade en extérieur, en pleine montée émotionnelle face à un stimulus',
};

// ── FAQ ───────────────────────────────────────────────────────────────────────
const faqItems: { question: string; answer: string }[] = [
  {
    question: 'Faut-il continuer à promener un chien qui déborde à chaque fois ?',
    answer:   'Oui. Arrêter les balades parce qu\'elles sont difficiles, c\'est la pire solution. L\'évitement ne règle rien : il renforce l\'incapacité du chien à gérer le monde extérieur, et le prive du seul vrai vecteur de dépense et de socialisation qu\'il a. Un chien qu\'on enferme pour le « protéger » des stimulations devient encore moins capable de les affronter. Ce qu\'il faut changer, ce n\'est pas la quantité de sorties, c\'est leur contenu et votre façon de les mener. Adaptez le lieu, l\'horaire, la distance avec les déclencheurs, travaillez la gestion émotionnelle progressivement, et si besoin faites-vous accompagner.',
  },
  {
    question: 'Faut-il éviter les autres chiens pendant le travail en balade ?',
    answer:   'Éviter, non. Empêcher l\'accès systématique en laisse, oui. Si vous laissez votre chien aller voir chaque congénère, vous lui apprenez qu\'il obtient tout, tout de suite, et il devient ingérable. En laisse, instaurez le « zéro contact » : il peut voir les autres chiens, mais sans aller au contact. En parallèle, gardez des interactions libres et cadrées dans de bons contextes, parce que des rencontres régulières banalisent les congénères. C\'est l\'équilibre entre les deux qui stabilise un chien dehors.',
  },
  {
    question: 'Mon chien déborde surtout au retour de balade, pas au départ. Pourquoi ?',
    answer:   'C\'est fréquent, et souvent le signe que la balade est mal séquencée. Beaucoup de propriétaires font monter leur chien en excitation en fin de sortie (jeu, course, gros stimulus) puis rentrent directement. Le chien arrive à la maison encore en pic. Inversez la séquence : dépense physique et jeu en début ou milieu de balade, puis reniflage et exploration lente sur les 10 dernières minutes. Il rentre déjà à mi-chemin de la redescente, la décompression à la maison finit le travail.',
  },
  {
    question: 'Mon chien est parfait au parc mais insupportable en ville, ou l\'inverse. Est-ce normal ?',
    answer:   'Oui, et c\'est même un indice précieux. Un chien à l\'aise en forêt et perdu en ville sature sur les stimulations rapprochées et le bruit : il faudra le travailler par exposition graduée en ville, aux heures creuses au début. Un chien à l\'aise en ville et perdu en pleine nature manque d\'expérience olfactive et de rappel dans un contexte à forte odeur : il faudra le travailler en longe, en forêt, sur du reniflage cadré. Ce ne sont pas les mêmes compétences.',
  },
  {
    question: 'La longe suffit-elle à régler le problème ?',
    answer:   'Non, la longe est un outil, pas une solution. Elle donne à votre chien de la latitude pour respirer et à vous du temps pour réagir. Mais si vous mettez une longe à un chien qui n\'a jamais appris le renoncement, vous obtenez juste un chien qui vrille avec cinq mètres d\'élan de plus. La longe accompagne le travail, elle ne le remplace pas.',
  },
  {
    question: 'Est-ce que la castration change quelque chose au débordement en balade ?',
    answer:   'Rarement dans le sens que les propriétaires espèrent. La castration peut réduire certains comportements liés directement à la testostérone (marquage, fuite pour aller voir une femelle en chaleur), mais elle n\'agit pas sur la gestion émotionnelle. Un chien qui déborde en balade parce qu\'il ne sait pas redescendre en excitation ne devient pas calme après castration. Pire, chez certains chiens anxieux, la castration accentue la peur. C\'est une décision médicale et comportementale, à discuter au cas par cas avec un vétérinaire comportementaliste, pas une solution magique au débordement.',
  },
];

// ── JSON-LD structured data ───────────────────────────────────────────────────
const siteUrl = Astro.site?.origin ?? 'https://kind-dog-training.fr';
const pageUrl  = Astro.url.href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type':       'Article',
      headline:      article.titleBefore + article.titleAccent + article.titleAfter,
      description:   page.metaDescription,
      datePublished: `${article.publishDateIso}T09:00:00+02:00`,
      dateModified:  `${article.updateDateIso}T09:00:00+02:00`,
      inLanguage:    'fr-FR',
      url:           pageUrl,
      image: {
        '@type':  'ImageObject',
        url:      siteUrl + '/images/article-gestion-emotions-balade.webp',
        width:    1116,
        height:   398,
      },
      author: { '@id': `${siteUrl}/qui-suis-je/#person` },
      publisher: { '@id': `${siteUrl}/#organization` },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id':   pageUrl,
      },
    },
    getAuthorPerson(siteUrl),
    getPublisherOrganization(siteUrl),
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil',                    item: siteUrl + '/' },
        { '@type': 'ListItem', position: 2, name: 'Éducation canine',           item: siteUrl + '/education-canine/' },
        { '@type': 'ListItem', position: 3, name: article.category,             item: siteUrl + article.categoryUrl },
        { '@type': 'ListItem', position: 4, name: article.parentLabel,          item: siteUrl + article.parentUrl },
        { '@type': 'ListItem', position: 5, name: article.hubLabel,             item: siteUrl + article.hubUrl },
        { '@type': 'ListItem', position: 6, name: article.breadcrumbLabel },
      ],
    },
    ...(faqItems.length > 0
      ? [{
          '@type': 'FAQPage',
          mainEntity: faqItems.map(({ question, answer }) => ({
            '@type': 'Question',
            name: question,
            acceptedAnswer: { '@type': 'Answer', text: answer },
          })),
        }]
