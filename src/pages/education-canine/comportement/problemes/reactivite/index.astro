          <div class="art-bio-avatar" aria-hidden="true">
            <img src="/images/melyne-auteur.webp" alt="Mélyne, éducatrice canine" width="64" height="64" loading="lazy" decoding="async" style="display:block;" />
          </div>
          <div>
            <p class="art-bio-name">À propos de {article.author}</p>
            <p class="art-bio-role">{article.authorRole}</p>
            <p class="art-bio-desc">{article.authorDesc}</p>
          </div>
        </div>
      </div>
    </footer>

  </article><!-- /article -->


  <!-- ── FAQ ───────────────────────────────────────────────────────── -->
  {faqItems.length > 0 && (
    <section class="section" id="faq" aria-labelledby="faq-heading">
      <div class="container" style="max-width: 750px;">
        <h2 id="faq-heading" style="text-align: center;">Questions fréquentes sur la <span class="accent">réactivité canine</span></h2>
        <div class="faq-list" style="margin-top: var(--sp-8);">
          {faqItems.map((item) => (
            <details class="faq-item">
              <summary class="faq-question">
                <span>{item.question}</span>
                <svg class="faq-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                </svg>
              </summary>
              <div class="faq-answer">
                <p>{item.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}


  <!-- ── CTA FINAL ──────────────────────────────────────────────────── -->
  <section class="section-dark art-cta-section" aria-labelledby="art-cta-h">
    <div class="container art-cta-inner">
      <h2 class="art-cta-title" id="art-cta-h">Envie de retrouver des balades sereines avec votre chien&nbsp;?</h2>
      <p>Bilan comportemental gratuit à domicile · Bordeaux et métropole</p>
      <a href="/prendre-rdv/" class="btn btn-primary">
        Réserver mon bilan gratuit
        <Icon name="arrow-right" width={18} height={18} strokeWidth={2} />
      </a>
    </div>
  </section>


  <!-- ── ARTICLES QUI PEUVENT VOUS INTÉRESSER ───────────────────────── -->
  <section class="art-related" aria-labelledby="art-related-h">
    <div class="container">
      <p class="art-related-divider" id="art-related-h">Articles qui peuvent vous intéresser</p>
      <div class="art-related-grid">
        {related.map((card) => (
          <a href={card.url} class="art-related-card">
            <img
              src={card.img}
              alt={card.imgAlt}
              class="art-related-card-img"
              width="360"
              height="180"
              loading="lazy"
              decoding="async"
            />
            <div class="art-related-card-body">
              <p class="art-related-card-title">{card.title}</p>
              <p class="art-related-card-meta">{card.readTime} de lecture</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── BARRE DE PROGRESSION ──────────────────────────────────────── -->
  <ArticleProgressBar />

  <script is:inline>
    (function () {
      var MIN_CHARS = 10;
      var feedbackWrap = document.getElementById('art-feedback');
      var likeBtn = document.getElementById('art-like-btn');
      var dislikeBtn = document.getElementById('art-dislike-btn');
      var feedbackForm = document.getElementById('art-feedback-form');
      var feedbackText = document.getElementById('art-feedback-text');
      var feedbackHint = document.getElementById('art-feedback-hint');
      var feedbackSubmit = document.getElementById('art-feedback-submit');
      var feedbackThanks = document.getElementById('art-feedback-thanks');

      if (!feedbackWrap || !likeBtn || !dislikeBtn) return;

      function sendGA4Event(eventName, params) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(Object.assign({ event: eventName }, params));
      }

      function getArticleTitle() {
        var h1 = document.querySelector('h1');
        return h1 ? h1.textContent.trim() : document.title;
      }

      function showThanks() {
        feedbackWrap.querySelectorAll('.art-feedback-buttons, .art-feedback-form, .art-feedback-question').forEach(
          function (el) { el.hidden = true; }
        );
        feedbackThanks.hidden = false;
      }

      likeBtn.addEventListener('click', function () {
        sendGA4Event('article_like', {
          page_url: window.location.href,
          article_title: getArticleTitle(),
        });
        showThanks();
      });

      dislikeBtn.addEventListener('click', function () {
        likeBtn.hidden = true;
        dislikeBtn.classList.add('art-feedback-btn--selected');
        dislikeBtn.disabled = true;
        feedbackForm.hidden = false;
        feedbackText.focus();
      });

      feedbackText.addEventListener('input', function () {
        var len = feedbackText.value.trim().length;
        var valid = len >= MIN_CHARS;
        feedbackSubmit.disabled = !valid;
        if (len === 0) {
          feedbackHint.textContent = MIN_CHARS + ' caractères minimum';
          feedbackHint.classList.remove('art-feedback-hint--ok');
        } else if (!valid) {
          feedbackHint.textContent = 'Encore ' + (MIN_CHARS - len) + ' caractère' + (MIN_CHARS - len > 1 ? 's' : '');
          feedbackHint.classList.remove('art-feedback-hint--ok');
        } else {
          feedbackHint.textContent = 'Prêt à envoyer';
          feedbackHint.classList.add('art-feedback-hint--ok');
        }
      });

      feedbackSubmit.addEventListener('click', function () {
        var text = feedbackText.value.trim();
        if (text.length < MIN_CHARS) return;
        sendGA4Event('article_dislike', {
          page_url: window.location.href,
          article_title: getArticleTitle(),
          user_feedback: text,
        });
        showThanks();
      });
    })();
  </script>

  <script>
    const btn = document.getElementById('art-copy-link');
    if (btn) {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
        } catch {
          const el = Object.assign(document.createElement('input'), { value: window.location.href });
          document.body.appendChild(el);
          el.select();
          document.execCommand('copy');
          el.remove();
        }
        btn.setAttribute('data-copied', '');
        setTimeout(() => btn.removeAttribute('data-copied'), 2000);
      });
    }
  </script>

</Layout>
