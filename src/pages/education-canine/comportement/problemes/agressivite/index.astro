            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Image hero -->
    <div class="art-hero-wrap">
      <div class="container">
        <figure class="art-hero">
          <picture>
            <source media="(max-width: 767px)" srcset="/images/article-agressivite-chien-mobile.webp" width="400" height="351" />
            <img
              src="/images/article-agressivite-chien.webp"
              alt={article.coverAlt}
              width="925"
              height="456"
              loading="eager"
              fetchpriority="high"
              decoding="async"
