// ── Page SEO ──────────────────────────────────────────────────────────────────
const page = {
  metaTitle:       'Pourquoi Votre Chien est Agressif ? Aucun cas n\'est désespéré',
  metaDescription: 'Agressivité chien : causes réelles (peur, douleur, socialisation), différence avec la réactivité, premières décisions à prendre face à un chien qui mord.',
};

// ── Article metadata ──────────────────────────────────────────────────────────
const article = {
  category:       'Comportement',
  categoryUrl:    '/education-canine/comportement/',
  parentLabel:    'Problèmes',
  parentUrl:      '/education-canine/comportement/problemes/',
  breadcrumbLabel:'Agressivité chez le chien',
  titleBefore:    '',
  titleAccent:    'Agressivité',
  titleAfter:     ' chez le chien : comprendre, prévenir, rééduquer',
  publishDate:    '11 septembre 2026',
  publishDateIso: '2026-09-11',
  updateDate:     '11 septembre 2026',
  updateDateIso:  '2026-09-11',
  readTime:       '20 min',
  author:         'Mélyne',
  authorInitial:  'M',
  authorRole:     'Éducatrice & comportementaliste canin · Bordeaux',
  authorDesc:     'Passionnée par la relation entre l\'humain et le chien, j\'accompagne les propriétaires dans l\'éducation et la rééducation de leur chien, quelle que soit la problématique.',
  coverAlt:       'Chien montrant les crocs en posture défensive, illustrant l\'agressivité canine et ses signaux d\'avertissement',
};

// ── FAQ ───────────────────────────────────────────────────────────────────────
const faqItems: { question: string; answer: string }[] = [
  {
    question: 'Peut-on vraiment rééduquer un chien agressif à l\'âge adulte ?',
    answer:   'Oui, dans l\'immense majorité des cas. La rééducation d\'un chien adulte demande plus de temps et de rigueur que l\'éducation d\'un chiot, mais elle est possible. Les séquelles d\'une mauvaise gestion peuvent limiter une réhabilitation totale, votre chien n\'aimera peut-être jamais ses congénères ou tous les humains, mais il est toujours possible de supprimer le passage à l\'acte et de restaurer une vie sociale sereine. J\'ai accompagné des chiens de six, huit, dix ans avec des progressions significatives. La bonne question à se poser porte sur votre disponibilité à changer les choses, jamais sur l\'âge du chien.',
  },
  {
    question: 'Faut-il envisager l\'euthanasie après une morsure ?',
    answer:   'Pas en première intention, et surtout pas sans analyse comportementale sérieuse. L\'euthanasie pour trouble du comportement est presque toujours l\'aveu d\'un échec humain ou d\'un professionnel qui ne sait pas travailler ce type de problème. La bonne question, après une morsure, porte sur le contexte : dans quelles conditions cette morsure s\'est produite, et qu\'est-ce qu\'on peut modifier. Dans certains cas rares, quand la sécurité de personnes vulnérables ne peut plus être garantie, l\'euthanasie devient une décision responsable. Elle doit alors venir d\'une vraie évaluation, jamais d\'un réflexe de panique ni d\'un professionnel qui abdique.',
  },
  {
    question: 'La castration réduit-elle l\'agressivité ?',
    answer:   'Ça dépend beaucoup du type d\'agressivité et du profil du chien. Pour une agressivité congénère hormonale, où un mâle ne supporte pas les autres mâles entiers, une castration au bon moment peut apporter 20 à 30 % de gain, en réduisant la testostérone et en augmentant les œstrogènes. Pour toutes les autres formes d\'agressivité (par peur, territoriale, par protection de ressources, redirigée), la castration ne change rien. Attention aussi aux femelles : la stérilisation augmente parfois la testostérone et baisse les œstrogènes, ce qui peut au contraire aggraver certaines réactivités. Décision à prendre au cas par cas, jamais en réflexe.',
  },
  {
    question: 'Mon chien grogne sur mon enfant, comment réagir ?',
    answer:   'D\'abord, ne surtout pas punir le grognement. Le grognement est un avertissement précieux : il vous dit que votre chien est mal à cet endroit et à ce moment. Si vous le sanctionnez, vous supprimez le signal mais pas le malaise, et vous augmentez le risque d\'une morsure sans prévenir. Ensuite, mettez l\'enfant en sécurité immédiatement, sans dramatiser mais sans négocier. Un enfant n\'est pas en âge de comprendre qu\'il faut respecter le repos du chien. La responsabilité vous appartient. Enfin, appelez un éducateur ou un comportementaliste sérieux tout de suite, avant qu\'un incident plus grave n\'arrive. Dans le cas particulier d\'une prédation intra-foyer sur enfant, où le chien fixe et cherche à poursuivre son propre enfant, la décision responsable est de replacer le chien dans un foyer sans enfant. Techniquement, ça peut se travailler, mais on ne met jamais un enfant en jeu comme cobaye d\'une rééducation.',
  },
];

// ── JSON-LD structured data ───────────────────────────────────────────────────
