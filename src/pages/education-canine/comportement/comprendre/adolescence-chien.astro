  { label: 'Un cadre flou depuis le début',                             href: '#cadre-flou',                      sub: true  },
  { label: 'Une socialisation incomplète',                              href: '#socialisation-incomplete',        sub: true  },
  { label: 'Des besoins qui ont grandi avec lui',                       href: '#besoins-qui-ont-grandi',          sub: true  },
  { label: 'Quand le jeune chien prend de l\'assurance',                href: '#prise-assurance',                 sub: false },
  { label: 'Une prise de confiance naturelle à cet âge',                href: '#prise-confiance',                 sub: true  },
  { label: 'Les acquis qui s\'effritent',                               href: '#acquis-effritent',                sub: true  },
  { label: 'Vos ordres qui ne veulent plus rien dire',                  href: '#trop-parler',                     sub: true  },
  { label: 'Reprendre les bases au lieu d\'attendre',                   href: '#reprendre-les-bases',             sub: false },
  { label: 'Pourquoi laisser couler enracine les habitudes',            href: '#laisser-couler',                  sub: true  },
  { label: 'Le piège du « il a changé à l\'adolescence »',              href: '#piege-il-a-change',               sub: true  },
  { label: 'Saturer les besoins avant d\'exiger',                       href: '#saturer-besoins',                 sub: true  },
  { label: 'Travailler le renoncement et l\'auto-contrôle',             href: '#renoncement-auto-controle',       sub: true  },
  { label: 'Restaurer le suivi naturel',                                href: '#suivi-naturel',                   sub: true  },
  { label: 'Ce que les hormones changent réellement',                   href: '#hormones',                        sub: false },
  { label: 'Le vrai poids des changements physiologiques',              href: '#poids-physiologique',             sub: true  },
  { label: 'Pourquoi un chien stable le reste',                         href: '#chien-stable-le-reste',           sub: true  },
  { label: 'Les troubles qu\'on met à tort sur le dos de cette période',href: '#troubles-a-tort',                 sub: false },
  { label: 'La fugue, presque toujours un défaut de lien',              href: '#fugue',                           sub: true  },
  { label: 'L\'anxiété de séparation et la stérilisation',              href: '#anxiete-sterilisation',           sub: true  },
];

// ── Articles connexes ─────────────────────────────────────────────────────────
const related = [
  {
    title:    'Mon chien a du mal à gérer ses émotions en balade',
    readTime: '13 min',
    img:      '/images/article-gestion-emotions-balade.webp',
    imgAlt:   'Chien en balade en extérieur, en pleine montée émotionnelle face à un stimulus',
