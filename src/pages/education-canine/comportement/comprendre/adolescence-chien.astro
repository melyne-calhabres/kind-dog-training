---
import Layout from '../../../../layouts/Layout.astro';
import Icon from '../../../../components/Icon.astro';
import ArticleProgressBar from '../../../../components/ArticleProgressBar.astro';
import '../../../../styles/services.css';
import '../../../../styles/article.css';

// ── Page SEO ──────────────────────────────────────────────────────────────────
const page = {
  metaTitle:       'Adolescence du Chien : la Fausse Coupable de Tous vos Soucis',
  metaDescription: 'Adolescence du chien : on accuse souvent l\'âge à tort. Comprenez (vraiment) pourquoi votre jeune chien n\'écoute plus et comment reprendre les bases sans attendre.',
};

// ── Article metadata ──────────────────────────────────────────────────────────
const article = {
  category:       'Comportement',
  categoryUrl:    '/education-canine/comportement/',
  parentLabel:    'Comprendre',
  parentUrl:      '/education-canine/comportement/comprendre/',
  breadcrumbLabel:'Adolescence du chien',
  titleBefore:    '',
  titleAccent:    'Adolescence du chien',
  titleAfter:     ' : la phase qu\'on accuse trop vite de tout',
  publishDate:    '1 juillet 2026',
  publishDateIso: '2026-07-01',
  readTime:       '15 min',
  author:         'Mélyne',
  authorRole:     'Éducatrice & comportementaliste canin · Bordeaux',
  authorDesc:     'Passionnée par la relation entre l\'humain et le chien, j\'accompagne les propriétaires dans l\'éducation et la rééducation de leur chien, quelle que soit la problématique.',
  coverAlt:       'Jeune chien adolescent en extérieur, attentif, à la sortie de sa phase chiot',
};

// ── FAQ ───────────────────────────────────────────────────────────────────────
const faqItems: { question: string; answer: string }[] = [
  {
    question: 'À quel âge l\'adolescence du chien se termine-t-elle vraiment ?',
    answer:   'Ça dépend beaucoup du gabarit et de la race. En gros, l\'adolescence démarre vers six à huit mois et s\'étire jusqu\'à un an et demi à deux ans pour les grands chiens, parfois moins pour les petites races. Mais la vraie réponse c\'est qu\'il ne faut pas attendre la fin de cette période comme une délivrance. Les comportements ne se règlent pas en soufflant les deux bougies. Ce qui aura été travaillé pendant l\'adolescence restera, ce qu\'on aura laissé filer aussi. La date de fin compte beaucoup moins que ce que vous faites pendant.',
  },
  {
    question: 'Faut-il revoir les règles à la maison à cette période ?',
    answer:   'Pas tant les revoir que les tenir vraiment. Si votre chien commence à s\'autoriser des libertés, c\'est rarement parce que les règles sont mauvaises, c\'est qu\'elles ne sont plus appliquées avec constance, ou pas par tout le monde de la même façon. Le point le plus important reste la cohérence entre les membres du foyer : mêmes interdits, mêmes autorisations. Un chien qui reçoit des messages contradictoires devient imprévisible. C\'est souvent là, plus que dans une règle précise, que se cache le vrai chantier à cet âge.',
  },
  {
    question: 'La castration peut-elle aider à passer le cap plus facilement ?',
    answer:   'Il faut être clair : la castration n\'a pas pour effet direct de calmer un chien. Elle stoppe la reproduction, fait baisser la testostérone et monter les œstrogènes, rien de plus côté comportement. Dans certains cas précis de réactivité liée aux hormones entre mâles, faite au bon moment, elle peut apporter un coup de pouce. Mais c\'est rarement une solution à un problème d\'éducation et je la déconseille régulièrement quand on me la présente comme la réponse miracle à un chien mal cadré. Si besoin, un implant chimique permet de tester l\'effet avant toute décision définitive. Le travail de fond, lui, reste indispensable.',
  },
];

// ── JSON-LD structured data ───────────────────────────────────────────────────
const siteUrl = Astro.site?.origin ?? 'https://kind-dog-training.fr';
const pageUrl  = Astro.url.href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type':       'Article',
      headline:      article.titleBefore + article.titleAccent + article.titleAfter,
      description:   page.metaDescription,
      datePublished: '2026-07-01T09:00:00+02:00',
      dateModified:  '2026-07-01T09:00:00+02:00',
      inLanguage:    'fr-FR',
      url:           pageUrl,
      image: {
        '@type':  'ImageObject',
        url:      siteUrl + '/images/article-adolescence-chien.webp',
        width:    925,
        height:   456,
      },
      author: {
        '@type':    'Person',
        name:       article.author,
        url:        siteUrl + '/qui-suis-je/',
        jobTitle:   'Éducatrice & comportementaliste canin',
        description: article.authorDesc,
      },
      publisher: {
        '@type': 'Organization',
        name:    'Kind Dog Training',
        url:     siteUrl,
        logo: {
          '@type': 'ImageObject',
          url:     siteUrl + '/images/logo.png',
        },
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id':   pageUrl,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil',                    item: siteUrl + '/' },
        { '@type': 'ListItem', position: 2, name: article.category,             item: siteUrl + article.categoryUrl },
        { '@type': 'ListItem', position: 3, name: article.parentLabel,          item: siteUrl + article.parentUrl },
        { '@type': 'ListItem', position: 4, name: article.breadcrumbLabel },
      ],
    },
    ...(faqItems.length > 0
      ? [{
          '@type': 'FAQPage',
          mainEntity: faqItems.map(({ question, answer }) => ({
            '@type': 'Question',
            name: question,
            acceptedAnswer: { '@type': 'Answer', text: answer },
          })),
        }]
      : []),
  ],
};

// ── TL;DR — L'essentiel ───────────────────────────────────────────────────────
const tldr = [
  'Dans la grande majorité des cas, ce n\'est pas l\'adolescence qui pose problème, mais des failles éducatives qui deviennent visibles à ce moment-là.',
  'Le jeune chien ne « teste » pas ses maîtres : il gagne en assurance et s\'autorise des libertés là où vous vous reposez sur vos acquis.',
  'Un cadre flou depuis le début, une socialisation incomplète ou une incohérence à la maison finissent toujours par se voir à cet âge.',
  'Les acquis s\'effritent quand on cesse de les entretenir et le fait de parler davantage en balade vide vos ordres de leur sens.',
  'Les hormones jouent à la marge. Un chien stable avant l\'adolescence le reste pendant.',
  'Laisser couler en attendant que « ça passe » ne fait qu\'installer durablement les nouvelles (mauvaises) habitudes.',
  'La fugue et l\'anxiété de séparation qui apparaissent à cette période ont presque toujours une autre cause que l\'âge.',
];

// ── Table of contents ─────────────────────────────────────────────────────────
const toc = [
  { label: 'Pourquoi l\'adolescence a si souvent bon dos',              href: '#pourquoi-bon-dos',                sub: false },
  { label: 'Le réflexe « c\'est l\'âge, ça va passer »',                 href: '#reflexe-age',                     sub: true  },
  { label: 'Ce que cette explication permet d\'éviter de regarder',     href: '#eviter-de-regarder',              sub: true  },
  { label: 'Les vraies causes derrière « il n\'écoute plus »',          href: '#vraies-causes',                   sub: false },
