---
import Layout from '../layouts/Layout.astro';

const partenaires = [
  {
    nom: 'Proxianimaux',
    url: 'https://www.proxianimaux.fr',
    logo: '/images/partenaires/proxianimaux.webp',
    activite: 'Annuaire pour professionnels du monde animal.',
  },
];
---

<Layout
  title="Nos partenaires — Kind Dog Training"
  description="Découvrez les partenaires de Kind Dog Training, éducateur canin à Bordeaux."
>
  <section class="page-header">
    <div class="container">
      <h1>Partenaires</h1>
    </div>
  </section>

  <section class="section" style="padding-top: var(--sp-12);">
    <div class="container">
      <ul class="partners-grid">
        {partenaires.map((p) => (
          <li class="partner-card">
            <img
              src={p.logo}
              alt={`Logo ${p.nom}`}
              width="120"
              height="120"
              loading="lazy"
              decoding="async"
              class="partner-logo"
            />
            <h2 class="partner-name">{p.nom}</h2>
            <p class="partner-activite">{p.activite}</p>
            <a
              href={p.url}
              target="_blank"
              rel="noopener"
              class="btn btn-primary partner-link"
            >
              Visiter le site
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .partners-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 320px));
    gap: var(--sp-8);
    justify-content: center;
  }

  .partner-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: #fff;
    border-radius: 16px;
    padding: var(--sp-8) var(--sp-6);
    box-shadow: var(--shadow-md);
    transition: box-shadow var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }

  .partner-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .partner-logo {
    width: 120px;
    height: 120px;
    object-fit: contain;
    margin-bottom: var(--sp-5);
  }

  .partner-name {
    margin: 0 0 var(--sp-3);
    font-size: 1.25rem;
  }

  .partner-activite {
    margin: 0 0 var(--sp-6);
    color: var(--color-text-muted, inherit);
  }

  .partner-link {
    margin-top: auto;
  }
</style>
