---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="Prendre rendez-vous — Kind Dog Training, éducateur canin à Bordeaux"
  description="Prenez rendez-vous avec Mélyne, éducatrice canine à Bordeaux. Bilan comportemental gratuit à votre domicile. Réponse sous 48h."
  preloadImages={[
    { href: '/images/hero-rdv-mobile-photo.webp', media: '(max-width: 767px)' },
    { href: '/images/hero-rdv-desktop-photo.webp', media: '(min-width: 768px)' },
  ]}
>
  <!-- HERO -->
  <section class="hero hero--rdv" aria-labelledby="hero-rdv-heading">
    <div class="container">
      <div class="hero-content">
        <h1 id="hero-rdv-heading">Prise de rendez-vous avec <span class="accent">Kind Dog Training</span></h1>
        <p class="hero-subtitle">
          Vous pouvez me contacter via le formulaire ou directement par téléphone. Planifiez dès maintenant votre bilan comportemental offert&nbsp;!
        </p>
      </div>
    </div>
  </section>

  <section class="section booking-section">
    <div class="container">
      <div class="booking-grid">
        <header class="booking-info">
          <h2>Réservez votre <span class="accent">bilan gratuit</span>.</h2>
          <p style="font-size: 16px; line-height: 1.65; color: var(--kd-bark); max-width: 460px;">
            Un premier rendez-vous à votre domicile pour comprendre votre situation,
            observer votre chien dans son environnement, et vous proposer un plan d'action sur-mesure.
            Aucun engagement à ce stade.
          </p>
          <p style="font-size: 16px; color: var(--kd-ink); max-width: 460px; margin-top: var(--sp-3);">
            <strong>Remplissez le formulaire pour prendre rdv !</strong>
          </p>
          <address class="booking-contacts">
            <p class="contact-row">
              <span class="contact-icon">
                <Icon name="mail" width={18} height={18} strokeWidth={1.75} />
              </span>
              <span class="contact-label">kindogtraining@gmail.com</span>
            </p>
            <p class="contact-row">
              <span class="contact-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </span>
              <span class="contact-label">
                <a href="https://www.instagram.com/kind_dog_training/" target="_blank" rel="noopener noreferrer" class="contact-link">@kind_dog_training</a>
              </span>
            </p>
            <p class="contact-row">
              <span class="contact-icon">
                <Icon name="phone" width={18} height={18} strokeWidth={1.75} />
              </span>
              <span class="contact-label">
                <a href="tel:+33642648914" class="contact-link">+33 6 42 64 89 14</a>
              </span>
            </p>
            <p class="contact-row">
              <span class="contact-icon">
                <Icon name="map-pin" width={18} height={18} strokeWidth={1.75} />
              </span>
              <span class="contact-label">Bordeaux + 30 km</span>
            </p>
            <p class="contact-row">
              <span class="contact-icon">
                <Icon name="message-circle" width={18} height={18} strokeWidth={1.75} />
              </span>
              <span class="contact-label">Suivi WhatsApp 7j/7 · réponse sous 48h</span>
            </p>
          </address>
        </header>

        <ContactForm />
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero--rdv {
    background-image: url('/images/hero-rdv-mobile-photo.webp');
  }

  @media (min-width: 768px) {
    .hero--rdv {
      background-image: url('/images/hero-rdv-desktop-photo.webp');
      align-items: center;
      padding-bottom: 0;
    }
  }

  /* Fond blanc pour la section booking */
  .booking-section {
    background: var(--color-surface-raised);
  }

  @media (max-width: 767px) {
    .booking-section {
      padding-top: var(--sp-8);
    }
  }

  .booking-grid {
    display: grid;
    gap: var(--sp-10);
  }

  @media (min-width: 900px) {
    .booking-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .booking-info h2 {
    margin-bottom: var(--sp-4);
  }

  .booking-contacts {
    margin-top: var(--sp-8);
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .contact-row {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--kd-cream);
    border-radius: 8px;
    color: var(--kd-terracotta);
    flex-shrink: 0;
  }

  .contact-label {
    font-size: var(--fs-base);
    color: var(--kd-bark);
  }

  .contact-link {
    color: var(--kd-terracotta);
    text-decoration: none;
    font-weight: 600;
  }

  .contact-link:hover {
    text-decoration: underline;
  }
</style>
