---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import '../styles/homepage.css';
import '../styles/forms.css';
import '../styles/booking.css';
---

<Layout
  title="Prendre rendez-vous — Kind Dog Training, éducateur canin à Bordeaux"
  description="Prenez rendez-vous avec Mélyne, éducatrice canine à Bordeaux. Bilan comportemental gratuit à votre domicile. Réponse sous 48h."
  preloadImages={[
    { href: '/images/hero-rdv-mobile-photo.webp', media: '(max-width: 767px)' },
    { href: '/images/hero-rdv-desktop-photo.webp', media: '(min-width: 768px)' },
  ]}
>
  <!-- HERO -->
  <section class="hero hero--rdv" aria-labelledby="hero-rdv-heading">
    <div class="container">
      <div class="hero-content">
        <h1 id="hero-rdv-heading">Prise de rendez-vous avec <span class="accent">Kind Dog Training</span></h1>
        <p class="hero-subtitle">
          Vous pouvez me contacter via le formulaire ou directement par téléphone. Planifiez dès maintenant votre bilan comportemental offert&nbsp;!
        </p>
      </div>
    </div>
  </section>

  <section class="section booking-section">
    <div class="container">
      <div class="booking-grid">
        <header class="booking-info">
          <h2>Réservez votre <span class="accent">bilan gratuit</span>.</h2>
          <p style="font-size: 16px; line-height: 1.65; color: var(--kd-bark); max-width: 460px;">
            Un premier rendez-vous à votre domicile pour comprendre votre situation,
            observer votre chien dans son environnement, et vous proposer un plan d'action sur-mesure.
            Aucun engagement à ce stade.
          </p>
          <p style="font-size: 16px; color: var(--kd-ink); max-width: 460px; margin-top: var(--sp-3);">
            <strong>Remplissez le formulaire pour prendre rdv !</strong>
          </p>
          <address class="booking-contacts">
            <p class="contact-row">
              <span class="contact-icon">
                <Icon name="mail" width={18} height={18} strokeWidth={1.75} />
              </span>
              <span class="contact-label">kindogtraining@gmail.com</span>
            </p>
            <p class="contact-row">
              <span class="contact-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </span>
              <span class="contact-label">
                <a href="https://www.instagram.com/kind_dog_training/" target="_blank" rel="noopener noreferrer" class="contact-link">@kind_dog_training</a>
              </span>
            </p>
            <p class="contact-row">
              <span class="contact-icon">
                <Icon name="phone" width={18} height={18} strokeWidth={1.75} />
              </span>
              <span class="contact-label">
                <a href="tel:+33642648914" class="contact-link">+33 6 42 64 89 14</a>
              </span>
            </p>
            <p class="contact-row">
              <span class="contact-icon">
                <Icon name="map-pin" width={18} height={18} strokeWidth={1.75} />
              </span>
              <span class="contact-label">Bordeaux + 30 km</span>
            </p>
            <p class="contact-row">
              <span class="contact-icon">
                <Icon name="message-circle" width={18} height={18} strokeWidth={1.75} />
              </span>
              <span class="contact-label">Suivi WhatsApp 7j/7 · réponse sous 48h</span>
            </p>
          </address>
        </header>

        <div class="booking-form-wrap">
          <a
            class="google-rating-badge"
            href="https://share.google/y9oqE2AvoPW7WO68S"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Note de 5 sur 5 basée sur 16 avis Google clients"
          >
            <span class="google-rating-badge__mark" aria-hidden="true">
              <svg viewBox="0 0 48 48" width="22" height="22">
                <path fill="#4285F4" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.2-.1-2.3-.4-3.5z"/>
                <path fill="#34A853" d="M6.3 14.1l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.1z"/>
                <path fill="#FBBC05" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2c-2 1.4-4.5 2.4-7.2 2.4-5.2 0-9.6-3.3-11.2-7.9l-6.5 5C9.6 39.6 16.2 44 24 44z"/>
                <path fill="#EA4335" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.1-4.1 5.5l6.2 5.2C40.7 35.7 44 30.3 44 24c0-1.2-.1-2.3-.4-3.5z"/>
              </svg>
            </span>
            <span class="google-rating-badge__content">
              <span class="google-rating-badge__top">
                <span class="google-rating-badge__score">5,0</span>
                <span class="google-rating-badge__stars" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14"><path d="M12 2.5l2.95 6.6 7.05.7-5.35 4.85 1.6 7.35L12 18l-6.25 4 1.6-7.35L2 9.8l7.05-.7L12 2.5z" fill="#E8A33D" stroke="#E8A33D" stroke-width="1.2" stroke-linejoin="round"/></svg>
                  <svg viewBox="0 0 24 24" width="14" height="14"><path d="M12 2.5l2.95 6.6 7.05.7-5.35 4.85 1.6 7.35L12 18l-6.25 4 1.6-7.35L2 9.8l7.05-.7L12 2.5z" fill="#E8A33D" stroke="#E8A33D" stroke-width="1.2" stroke-linejoin="round"/></svg>
                  <svg viewBox="0 0 24 24" width="14" height="14"><path d="M12 2.5l2.95 6.6 7.05.7-5.35 4.85 1.6 7.35L12 18l-6.25 4 1.6-7.35L2 9.8l7.05-.7L12 2.5z" fill="#E8A33D" stroke="#E8A33D" stroke-width="1.2" stroke-linejoin="round"/></svg>
                  <svg viewBox="0 0 24 24" width="14" height="14"><path d="M12 2.5l2.95 6.6 7.05.7-5.35 4.85 1.6 7.35L12 18l-6.25 4 1.6-7.35L2 9.8l7.05-.7L12 2.5z" fill="#E8A33D" stroke="#E8A33D" stroke-width="1.2" stroke-linejoin="round"/></svg>
                  <svg viewBox="0 0 24 24" width="14" height="14"><path d="M12 2.5l2.95 6.6 7.05.7-5.35 4.85 1.6 7.35L12 18l-6.25 4 1.6-7.35L2 9.8l7.05-.7L12 2.5z" fill="#E8A33D" stroke="#E8A33D" stroke-width="1.2" stroke-linejoin="round"/></svg>
                </span>
              </span>
              <span class="google-rating-badge__meta">Basé sur 16 avis Google</span>
            </span>
          </a>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero--rdv {
    background-image: url('/images/hero-rdv-mobile-photo.webp');
  }

  @media (min-width: 768px) {
    .hero--rdv {
      background-image: url('/images/hero-rdv-desktop-photo.webp');
      align-items: center;
      padding-bottom: 0;
    }
  }

  /* Fond blanc pour la section booking */
  .booking-section {
    background: var(--color-surface-raised);
  }

  @media (max-width: 767px) {
    .booking-section {
      padding-top: var(--sp-8);
    }
  }

  .booking-grid {
    display: grid;
    gap: var(--sp-10);
  }

  @media (min-width: 900px) {
    .booking-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .booking-info h2 {
    margin-bottom: var(--sp-4);
  }

  .booking-contacts {
    margin-top: var(--sp-8);
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .contact-row {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--kd-cream);
    border-radius: 8px;
    color: var(--kd-terracotta);
    flex-shrink: 0;
  }

  .contact-label {
    font-size: var(--fs-base);
    color: var(--kd-bark);
  }

  .contact-link {
    color: var(--kd-terracotta);
    text-decoration: none;
    font-weight: 600;
  }

  .contact-link:hover {
    text-decoration: underline;
  }

  .booking-form-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .google-rating-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    align-self: flex-start;
    padding: 10px 14px;
    background: #fff;
    border: 1px solid rgba(42, 30, 21, 0.08);
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(42, 30, 21, 0.06);
    text-decoration: none;
    color: var(--kd-ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .google-rating-badge:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(42, 30, 21, 0.1);
  }

  .google-rating-badge__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .google-rating-badge__content {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.2;
  }

  .google-rating-badge__top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .google-rating-badge__score {
    font-weight: 700;
    font-size: 15px;
    color: var(--kd-ink);
  }

  .google-rating-badge__stars {
    display: inline-flex;
    align-items: center;
    gap: 1px;
  }

  .google-rating-badge__meta {
    font-size: 12px;
    color: var(--kd-bark);
  }
</style>
