---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/homepage.css';
import '../../styles/services.css';

const siteUrl = Astro.site?.origin ?? 'https://kind-dog-training.fr';

const page = {
  metaTitle:       'Bilan comportemental offert pour votre chien',
  metaDescription: 'Le bilan comportemental est offert à Bordeaux avec Kind Dog Training ! On échange pour comprendre votre situation, observer et comprendre votre chien pour définir un plan d\'action adapté.',
};

const hero = {
  eyebrow:       'Bordeaux + 30 km',
  headline:      'Bilan comportemental',
  accent:        'pour votre chien.',
  lede:          'Un bilan complet pour comprendre votre situation, observer et comprendre votre chien pour définir un plan d\'action adapté.',
};

const deroulement = [
  {
    icon:  'home',
    title: '1. Observation à domicile',
    desc:  'Je me déplace chez vous pour observer votre chien dans son environnement naturel. C\'est là que les comportements sont les plus révélateurs et que je peux avoir une vision complète de la situation.',
  },
  {
    icon:  'message-circle',
    title: '2. Échange',
    desc:  'On prend le temps d\'échanger sur l\'histoire de votre chien, vos difficultés et vos objectifs. Cette étape est essentielle pour moi pour comprendre le contexte global et ne pas passer à côté d\'éléments importants.',
  },
  {
    icon:  'map-pin',
    title: '3. Balade',
    desc:  'On part faire une petite balade afin que je puisse voir vos comportements (vous et votre chien) en extérieur.',
  },
  {
    icon:  'book-open',
    title: '4. Synthèse écrite et plan sur mesure',
    desc:  'Après chaque bilan comportemental, vous recevrez une synthèse écrite contenant tous les éléments évoqués durant le rdv. Ce document vous présente également le plan d\'actions et/ou les premiers exercices à travailler. Nous pourrons ensuite planifier les premiers cours individuels.',
  },
];

const reviews = [
  {
    name:     'Victoria Pointet',
    date:     'Il y a 3 mois',
    text:     'J\'ai commencé à travailler avec Mélyne quand Brooklyn avait 4 mois, et honnêtement… quelle chance on a eue de la rencontrer ! Elle nous a accompagnés sur toutes les bases à instaurer, ainsi que la gestion des émotions, le rappel, la marche en laisse… toujours avec douceur et bonne humeur. Les résultats ont été rapides et durables.',
    gradient: 'linear-gradient(135deg, #C8623A, #E8A33D)',
  },
  {
    name:     'Cleora',
    date:     'Il y a 3 mois',
    text:     'J\'ai contacté Mélyne car je voulais mieux comprendre mon chien Vaillant, récemment adopté en refuge. Le contact a tout de suite été très naturel et Vaillant a eu un vrai coup de cœur pour notre coach ! Mélyne est très bienveillante et à l\'écoute. Petit bonus, chaque séance fait l\'objet d\'un compte-rendu écrit, ce qui est très appréciable !',
    gradient: 'linear-gradient(135deg, #9B6B47, #C8623A)',
  },
  {
    name:     'Cathy Le Corre',
    date:     'Il y a 3 mois',
    text:     'Une Educ au top, plein de bons conseils, consultée pour un toutou réactif ayant une mauvaise gestion des émotions (frustration, difficulté de renoncement, tirage en laisse, aboiements…) et des progrès dès la première séance ! Un accompagnement étape par étape avec un bilan à chaque séance, rien à dire, parfait !',
    gradient: 'linear-gradient(135deg, #5A8084, #8FB4B8)',
  },
];

const zones = [
  'Bordeaux', 'Mérignac', 'Pessac', 'Talence', 'Bègles',
  'Le Bouscat', 'Bruges', 'Eysines', 'Cenon', 'Floirac', 'Lormont',
];

const faqItems = [
  {
    question: 'Combien de temps dure le bilan comportemental ?',
    answer:   'Le bilan comportemental dure généralement entre 1h30 et 2h. Ce temps est nécessaire pour bien observer votre chien en situation réelle, échanger sur votre situation et vous présenter des recommandations adaptées.',
  },
  {
    question: 'Le bilan est-il obligatoire aussi pour les cours collectifs ?',
    answer:   'Oui ! Même si vous ne souhaitez participer qu\'aux cours collectifs, je dois tout de même voir votre chien et comprendre votre situation avant. Je fais en sorte de bien sélectionner les chiens pour chaque cours collectif afin que tout se passe bien pour tout le monde. Je ne peux pas faire venir un chien que je n\'ai jamais vu en cours collectif.',
  },
  {
    question: 'Sous combien de temps le bilan est-il planifié ?',
    answer:   'Tout dépend des disponibilités de chacun mais généralement on peut organiser un bilan entre 2 et 5 jours après votre premier contact :)',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

function initials(name: string) {
  const parts = name.trim().split(/\s+/);
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Bilan comportemental à Bordeaux',
      description: page.metaDescription,
      url: `${siteUrl}/services/bilan-comportemental/`,
      provider: {
        '@type': 'ProfessionalService',
        name: 'Kind Dog Training',
        url: siteUrl,
        telephone: '+33642648914',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Bruges',
          postalCode: '33520',
          addressRegion: 'Nouvelle-Aquitaine',
          addressCountry: 'FR',
        },
      },
      areaServed: {
        '@type': 'City',
        name: 'Bordeaux',
      },
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'EUR',
        description: 'Bilan comportemental gratuit à domicile',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil',  item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Services', item: `${siteUrl}/services/` },
        { '@type': 'ListItem', position: 3, name: 'Bilan comportemental' },
      ],
    },
  ],
};
---

<Layout title={page.metaTitle} description={page.metaDescription} jsonLd={jsonLd}>

  <!-- ── HERO ─────────────────────────────────────────────────────────── -->
  <section class="hero svc-hero" aria-labelledby="svc-h1">
    <picture>
      <source media="(min-width: 768px)" srcset="/images/hero-bilan-comportemental-desktop.webp" />
      <img
        src="/images/hero-bilan-comportemental-mobile.webp"
        alt=""
        class="svc-hero-img"
        fetchpriority="high"
        decoding="async"
        width="800"
        height="1067"
      />
    </picture>
    <div class="container">
      <div class="svc-hero-content">
        <nav aria-label="Fil d'Ariane" class="svc-hero-breadcrumb">
          <ol class="svc-breadcrumb">
            <li><a href="/">Accueil</a></li>
            <li><a href="/services/">Services</a></li>
            <li aria-current="page">Bilan comportemental</li>
          </ol>
        </nav>
        <span class="svc-location-pill">
          <Icon name="map-pin" width={13} height={13} strokeWidth={2} />
          {hero.eyebrow}
        </span>
        <h1 id="svc-h1" class="svc-h1">
          {hero.headline}<br>
          <span class="svc-acc">{hero.accent}</span>
        </h1>
        <p class="svc-lede">{hero.lede}</p>
        <div class="svc-btn-group">
          <a href="/prendre-rdv/" class="btn btn-primary">
            <Icon name="calendar" width={16} height={16} strokeWidth={2} />
            Prendre RDV
          </a>
          <a href="/tarif-educateur-canin-bordeaux/" class="svc-btn-ghost">Voir les tarifs</a>
        </div>
      </div>
    </div>
  </section>


  <!-- ── À QUOI SERT UN BILAN ? ────────────────────────────────────────── -->
  <section class="section svc-section-white" id="a-quoi-sert" aria-labelledby="utilite-heading">
    <div class="container">
      <div class="utilite-grid">

        <!-- Colonne gauche : titre + tags -->
        <div class="utilite-left">
          <h2 id="utilite-heading">À quoi sert un <span class="accent">bilan comportemental ?</span></h2>
          <div class="utilite-tags" aria-hidden="true">
            <span class="utilite-tag">
              <Icon name="user" width={14} height={14} strokeWidth={2} />
              Rencontre
            </span>
            <span class="utilite-tag">
              <Icon name="target" width={14} height={14} strokeWidth={2} />
              Observation
            </span>
            <span class="utilite-tag">
              <Icon name="map-pin" width={14} height={14} strokeWidth={2} />
              Balade
            </span>
          </div>
          <div class="utilite-callout">
            <p>Le bilan comportemental est le point de départ indispensable de tout accompagnement. Il sert à vous rencontrer et rencontrer votre chien, échanger ensemble sur vos problématiques et observer votre chien dans son environnement habituel.</p>
          </div>
        </div>

        <!-- Colonne droite : texte détaillé -->
        <div class="utilite-right">
          <p>Durant un bilan, on ne travaille pas vraiment directement sur vos besoins. Il s'agit davantage d'une discussion et d'observations de ma part. Avant de commencer à réfléchir à un plan d'action adapté, j'ai besoin de voir votre chien et de comprendre son passif. Que ce soit pour un <a href="/services/cours-collectifs/">cours collectif</a> ou un <a href="/services/cours-individuel-education-canine-bordeaux/">cours individuel</a>, l'étape du bilan est obligatoire.</p>
          <p>La plupart du temps vous avez des problématiques en extérieur et c'est pourquoi une petite balade est incluse dans le bilan comportemental. Cela me permet d'observer les comportements de votre chien (et les vôtres également) en conditions réelles. Si on doit travailler sur des problèmes de harcèlement avec les congénères, agressivité ou prédation par exemple, le plus cohérent est d'observer ça en condition réelle pour comprendre le <strong>pourquoi</strong>.</p>
        </div>

      </div>
    </div>
  </section>


  <!-- WAVE : white → cream -->
  <div class="wave-separator wave-sep--from-white" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 80" preserveAspectRatio="none">
      <path fill="#F4ECDC" d="M0,40 C360,0 1080,80 1440,40 L1440,80 L0,80 Z"/>
    </svg>
  </div>

  <!-- ── DÉROULEMENT D'UN BILAN ──────────────────────────────────────── -->
  <section class="section ci-section-deroulement" id="deroulement" aria-labelledby="deroulement-heading">
    <div class="container">
      <div class="ci-deroulement-grid">

        <h2 id="deroulement-heading" class="ci-deroulement-h2">
          Comment se déroule <span class="accent">le bilan ?</span>
        </h2>

        <div class="ci-deroulement-visual">
          <img
            src="/images/bilan-comportemental-bordeaux.webp"
            alt="chien en bilan comportemental à Bordeaux"
            class="ci-deroulement-img"
            loading="lazy"
            decoding="async"
            width="640"
            height="800"
          />
        </div>

        <div class="ci-steps">
          {deroulement.map((step) => (
            <div class="ci-step">
              <div class="ci-step-icon" aria-hidden="true">
                <Icon name={step.icon} width={22} height={22} strokeWidth={1.75} />
              </div>
              <div>
                <p class="ci-step-title">{step.title}</p>
                <p class="ci-step-desc" set:html={step.desc} />
              </div>
            </div>
          ))}
          <div class="ci-steps-cta">
            <a href="/prendre-rdv/" class="btn btn-primary">
              <Icon name="calendar" width={16} height={16} strokeWidth={2} />
              Prendre RDV
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- WAVE : cream → paper -->
  <div class="wave-separator wave-sep--from-cream" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 80" preserveAspectRatio="none">
      <path fill="#FBF6EC" d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z"/>
    </svg>
  </div>

  <!-- ── TARIFS ────────────────────────────────────────────────────────── -->
  <section class="section section-paper" id="tarifs" aria-labelledby="tarifs-heading">
    <div class="container" style="max-width: 680px;">
      <h2 id="tarifs-heading" style="text-align: center;">Tarif du bilan comportemental <span class="accent">pour votre chien</span></h2>
      <div class="svc-price-card" style="margin-top: var(--sp-8);">
        <p class="svc-price-label">Premier bilan</p>
        <div class="svc-price-row">
          <span class="svc-price-num">Gratuit</span>
        </div>
        <p class="svc-price-free">
          <span class="svc-check-mark" aria-hidden="true">✓</span>
          À domicile, sans engagement
        </p>
      </div>
      <p class="svc-price-note">* Bilan comportemental à 20&nbsp;€ si &gt;&nbsp;20&nbsp;km.</p>

      <!-- Pourquoi c'est gratuit -->
      <div class="bilan-gratuit-block">
        <h3 class="bilan-gratuit-h3">Pourquoi le bilan est gratuit avec Kind Dog Training ?</h3>
        <p>Je considère le bilan comportemental comme un échange et il me sert principalement à récolter des informations. Il s'agit évidemment d'un rdv indispensable pour tout accompagnement. Cependant, étant donné que nous ne travaillons pas vraiment sur vos problématiques, je préfère ne pas vous le facturer.</p>
        <p>Il est important pour moi d'établir une relation de confiance à la fois avec vous et avec votre chien. Vous êtes libre de prendre le recul nécessaire après le rdv sans avoir la pression de l'argent déjà dépensé. Si vous n'êtes pas convaincu pour X ou Y raison, vous n'aurez rien perdu.</p>
      </div>

      <div style="text-align: center; margin-top: var(--sp-6);">
        <a href="/tarif-educateur-canin-bordeaux/" class="ci-link-tarifs">
          Voir tous les tarifs et packs
          <Icon name="arrow-right" width={15} height={15} strokeWidth={2} />
        </a>
      </div>
    </div>
  </section>


  <!-- ── AVIS ──────────────────────────────────────────────────────────── -->
  <section class="kdtA" id="avis" aria-labelledby="svc-avis-heading">
    <div class="svc-kdta-inner">
      <div class="kdtA__header">
        <div class="kdtA__intro">
          <p class="kdtA__eyebrow">Avis Google · 5,0 / 5 sur 16 avis</p>
          <h2 id="svc-avis-heading" class="kdtA__title">
            Ils ont fait confiance à <span class="accent">Kind Dog Training</span>
          </h2>
        </div>
      </div>
      <div class="svc-reviews-grid">
        {reviews.map((r) => (
          <article class="kdtA__card">
            <div class="kdtA__card-head">
              <div class="kdtA__avatar" style={`background: ${r.gradient};`}>{initials(r.name)}</div>
              <div class="kdtA__name-block">
                <div class="kdtA__name">{r.name}</div>
                <div class="kdtA__date">{r.date}</div>
              </div>
            </div>
            <div class="kdtA__stars" aria-label="5 étoiles sur 5">
              {[...Array(5)].map(() => (
                <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                  <path
                    d="M12 2.5l2.95 6.6 7.05.7-5.35 4.85 1.6 7.35L12 18l-6.25 4 1.6-7.35L2 9.8l7.05-.7L12 2.5z"
                    fill="#E8A33D" stroke="#E8A33D" stroke-width="1.2" stroke-linejoin="round"
                  />
                </svg>
              ))}
            </div>
            <p class="kdtA__text">{r.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>


  <!-- ── ZONE STRIP ─────────────────────────────────────────────────────── -->
  <section class="svc-zone-strip" aria-label="Zone d'intervention">
    <span class="svc-zone-label">
      <Icon name="map-pin" width={14} height={14} strokeWidth={2} />
      Je me déplace à&nbsp;:
    </span>
    <div class="svc-zone-marquee-outer" aria-hidden="true">
      <div class="svc-zone-marquee-inner">
        {zones.map((z) => (
          <Fragment>
            <span class="svc-zone-sep">·</span>
            <span class="svc-zone-name">{z}</span>
          </Fragment>
        ))}
        <span class="svc-zone-sep">·</span>
        <span class="svc-zone-more">+ 17 communes · jusqu'à 30&nbsp;km</span>
        {zones.map((z) => (
          <Fragment>
            <span class="svc-zone-sep">·</span>
            <span class="svc-zone-name">{z}</span>
          </Fragment>
        ))}
        <span class="svc-zone-sep">·</span>
        <span class="svc-zone-more">+ 17 communes · jusqu'à 30&nbsp;km</span>
      </div>
    </div>
    <div class="svc-zone-static" aria-hidden="true">
      {zones.map((z) => (
        <Fragment>
          <span class="svc-zone-sep">·</span>
          <span class="svc-zone-name">{z}</span>
        </Fragment>
      ))}
      <span class="svc-zone-sep">·</span>
      <span class="svc-zone-more">+ 17 communes · jusqu'à 30&nbsp;km</span>
    </div>
  </section>


  <!-- ── FAQ ─────────────────────────────────────────────────────────── -->
  <section class="section" id="faq" aria-labelledby="faq-heading">
    <div class="container" style="max-width: 750px;">
      <h2 id="faq-heading" style="text-align: center;">Questions fréquentes sur le <span class="accent">bilan comportemental</span></h2>
      <div class="faq-list" style="margin-top: var(--sp-8);">
        {faqItems.map((item) => (
          <details class="faq-item">
            <summary class="faq-question">
              <h3 class="faq-h3">{item.question}</h3>
              <svg class="faq-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="faq-answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>


  <!-- ── CTA ───────────────────────────────────────────────────────────── -->
  <section class="section section-dark cta-section" aria-labelledby="svc-cta-heading">
    <div class="container">
      <div class="cta-bilan-card">
        <p class="svc-cta-title" id="svc-cta-heading">
          Réservez votre bilan comportemental <span class="accent">offert</span>
        </p>
        <p style="text-align: center; margin-bottom: var(--sp-6);">
          Chaque accompagnement débute par un bilan gratuit à votre domicile, sans engagement.
          Si la méthode vous convient, on planifie un premier cours. Sinon, vous n'aurez rien perdu.
        </p>
        <div style="text-align: center;">
          <a href="/prendre-rdv/" class="btn btn-primary">
            <Icon name="calendar" width={18} height={18} strokeWidth={1.75} />
            Prendre RDV
          </a>
        </div>
        <p style="text-align: center; margin-top: var(--sp-5); font-size: 0.8rem; color: var(--kd-fawn);">
          *Bilan comportemental à 20&nbsp;€ si &gt;20&nbsp;km.
        </p>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

</Layout>

<style>
/* ══ HERO ════════════════════════════════════════════════════════════════ */

.svc-section-white {
  background: var(--kd-white);
}

.svc-hero {
  align-items: flex-end;
  justify-content: flex-start;
  text-align: left;
}

.svc-hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  z-index: 0;
}

.svc-hero::before {
  z-index: 1;
  background: rgba(255, 255, 255, 0.45);
}

.svc-hero-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--sp-4);
}

.svc-location-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 14px;
  border-radius: var(--radius-pill);
  background: rgba(42, 30, 21, 0.07);
  border: 1px solid rgba(42, 30, 21, 0.22);
  font-size: 12px;
  font-weight: 600;
  color: var(--kd-ink);
}

.svc-h1 {
  font-family: var(--font-serif);
  font-size: clamp(34px, 4.8vw, 62px);
  font-weight: 500;
  line-height: 1.05;
  letter-spacing: -0.025em;
  color: var(--kd-ink);
  margin-bottom: 0;
  max-width: 640px;
}

@media (min-width: 768px) {
  .svc-h1 { max-width: 960px; }
}

.svc-acc { color: var(--kd-terracotta); }

.svc-lede {
  font-size: 19px;
  font-weight: 600;
  line-height: 1.6;
  color: var(--kd-ink);
  text-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
  max-width: 480px;
  margin-bottom: 0;
}

.svc-btn-group {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  margin-top: var(--sp-2);
}

.svc-btn-ghost {
  display: inline-flex;
  align-items: center;
  padding: 13.5px 28.5px;
  border-radius: var(--radius-pill);
  border: 1.5px solid var(--kd-bark);
  font-family: var(--font-sans);
  font-weight: 600;
  font-size: 15px;
  color: var(--kd-ink);
  text-decoration: none;
  transition:
    background-color var(--dur-base) var(--ease-out),
    color var(--dur-base) var(--ease-out),
    border-color var(--dur-base) var(--ease-out);
}
.svc-btn-ghost:hover {
  background-color: var(--kd-ink);
  border-color: var(--kd-ink);
  color: var(--kd-white);
  text-decoration: none;
}

/* ══ À QUOI SERT ════════════════════════════════════════════════════════ */

.utilite-grid {
  display: grid;
  gap: var(--sp-10);
  align-items: start;
}

.utilite-left h2 {
  margin-bottom: var(--sp-6);
}

/* Tags */
.utilite-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: var(--sp-8);
}

.utilite-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  border-radius: var(--radius-pill);
  background: var(--kd-cream-warm);
  border: 1px solid var(--kd-cream-deep);
  font-size: 13px;
