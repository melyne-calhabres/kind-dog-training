---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/homepage.css';
import '../../styles/services.css';

const siteUrl = Astro.site?.origin ?? 'https://kind-dog-training.fr';

const page = {
  metaTitle:       'Cours collectifs d\'éducation canine à Bordeaux - Groupes de 6 chiens max',
  metaDescription: 'Cours collectifs d\'éducation canine à Bordeaux. Groupes de 6 chiens maximum, soigneusement constitués, pour travailler l\'obéissance et la socialisation dans un cadre convivial.',
};

const hero = {
  eyebrow:        'Bordeaux + 30 km',
  headline:       'Cours collectifs d\'éducation',
  headlineLine2:  'canine',
  accent:         'à Bordeaux.',
  lede:           'Profitez d\'un cadre convivial avec de la bonne humeur et du jeu pour faire progresser votre chien en présence d\'autres congénères.',
};

const benefits = [
  {
    icon:  'user',
    title: 'Groupes de 6 chiens maximum',
    text:  'Je limite volontairement la taille des groupes pour pouvoir assurer un cours et des interactions de la meilleure qualité possible.',
  },
  {
    icon:  'dog',
    title: 'Une sélection pensée pour chacun',
    text:  'Je compose les groupes selon le tempérament, les objectifs et le niveau de chaque chien pour être certaine que tout le monde progresse dans de bonnes conditions.',
  },
  {
    icon:  'target',
    title: 'Travail en présence de distractions',
    text:  'Le format collectif permet de renforcer le lien et la progression avec votre chien dans un environnement stimulant. Il est souvent question de renonciation et gestion de la frustration. Les cours collectifs sont particulièrement adaptés pour les chiens qui ont besoin de travailler ces aspects.',
  },
  {
    icon:  'paw-print',
    title: 'Un jeu à chaque fin de cours',
    text:  'Chaque cours collectif se termine par un petit jeu selon le thème du cours. Il m\'est par exemple arrivé d\'organiser un parcours à effectuer dans le meilleur temps possible après un cours ayant pour thème l\'agility ou encore un 1-2-3 soleil après un cours ayant pour thème la gestion des émotions.',
  },
];

const deroulement = [
  {
    icon:  'home',
    title: '1. Bilan comportemental gratuit',
    desc:  'Sauf si je connais déjà votre chien, avant de rejoindre un cours collectif, je me déplace chez vous pour établir un <a href="/services/bilan-comportemental/">bilan comportemental</a> gratuit à votre domicile. J\'observe son comportement dans son environnement et je m\'assure que le format collectif est adapté à sa situation.',
  },
  {
    icon:  'user',
    title: '2. Constitution du groupe et choix du thème',
    desc:  'Je sélectionne et compose chaque groupe selon le niveau et le tempérament des chiens afin que la séance se déroule dans les meilleures conditions pour tout le monde. Je pars du principe que, même si on est là pour faire progresser nos chiens, on peut faire des exercices tout en s\'amusant. C\'est pourquoi je choisis un thème pour chaque cours. Exemples&nbsp;: sécurité routière, gestion des émotions, agility, etc.',
  },
  {
    icon:  'trophy',
    title: '3. Exercices + jeu !',
    desc:  'Une fois que la séance est terminée, j\'organise un jeu avec tous les chiens présents selon le thème du cours. J\'ai par exemple organisé un 1-2-3-soleil lors d\'un cours sur le thème de la gestion des émotions. Cela peut être un exercice particulièrement intéressant et stimulant pour votre chien et cela vous permet de partager un excellent moment avec lui (et c\'est rigolo pour moi aussi).',
  },
  {
    icon:  'message-circle',
    title: '4. Bilan écrit & suivi WhatsApp',
    desc:  'Comme pour les <a href="/services/cours-individuel-education-canine-bordeaux/">cours individuels</a>, vous aurez un récapitulatif écrit après chaque cours collectif pour faire le suivi de la progression de votre chien et voir les exercices qui méritent d\'être approfondis.',
  },
];

const reviews = [
  {
    name:     'twinzeko',
    date:     'Il y a 3 mois',
    text:     'Mélyne nous suit depuis bientôt un an et c\'est un réel bonheur. Une écoute attentive et de très bons conseils. On voit une vraie différence dans le comportement de notre petite Appa qui a frôlé la réactivité mais qu\'on a réussi à corriger ! Une éducatrice qui met le chien au centre de la discussion et fait passer le bien-être animal en priorité.',
    gradient: 'linear-gradient(135deg, #C8623A, #E8A33D)',
  },
  {
    name:     'Jacques',
    date:     'Il y a 4 mois',
    text:     'J\'ai fait appel à Mélyne pour régler quelques problèmes avec mon staffy de 7 ans, notamment pour un problème de communication avec ses congénères. Les cours ont été très concluants, les exercices sont simples et efficaces. Bilan gratuit, éducation positive et rempli d\'amour. On voit que c\'est pour Mélyne une vraie passion avant tout.',
    gradient: 'linear-gradient(135deg, #9B6B47, #C8623A)',
  },
  {
    name:     'Aub\'Animaux',
    date:     'Il y a 2 mois',
    text:     'Mélyne est une passionnée du chien et de son travail d\'éducatrice. Elle est le genre de professionnelle à persévérer : elle ne s\'arrête pas à un protocole ou à une méthode qui ne correspond pas à un chien. Elle a tout un tas d\'outils dans sa besace, elle sort des sentiers battus et se creuse la tête pour trouver ce qui correspond au chien. Aucun jugement de sa part, uniquement des faits, des conseils, des explications. Merci KDT, à bientôt 🐾',
    gradient: 'linear-gradient(135deg, #5A8084, #8FB4B8)',
  },
];

const zones = [
  'Bordeaux', 'Mérignac', 'Pessac', 'Talence', 'Bègles',
  'Le Bouscat', 'Bruges', 'Eysines', 'Cenon', 'Floirac', 'Lormont',
];

const faqItems = [
  {
    question: 'Comment sont constitués les groupes ?',
    answer:   'Je compose chaque groupe avec soin, en fonction du niveau, de l\'âge et du tempérament des chiens, afin que la séance profite à tout le monde. Les groupes sont limités à 6 chiens maximum.',
  },
  {
    question: 'Mon chien est craintif ou réactif, peut-il participer à un cours collectif ?',
    answer:   'Cela dépend de sa situation. C\'est justement l\'objet du bilan comportemental gratuit qui précède tout accompagnement : j\'évalue si le format collectif est adapté à votre chien, ou s\'il est préférable de commencer par des cours individuels avant d\'envisager le collectif.',
  },
  {
    question: 'Est-ce que vous proposez également des cours individuels ?',
    answer:   'Oui, je propose aussi des cours individuels 100 % personnalisés si votre chien a besoin d\'un accompagnement plus ciblé avant ou en complément du format collectif.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

function initials(name: string) {
  const parts = name.trim().split(/\s+/);
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Cours d\'éducation canine collectif à Bordeaux',
  description: page.metaDescription,
  url: `${siteUrl}/services/cours-collectifs/`,
  provider: {
    '@type': 'ProfessionalService',
    name: 'Kind Dog Training',
    url: siteUrl,
    telephone: '+33642648914',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Bruges',
      postalCode: '33520',
      addressRegion: 'Nouvelle-Aquitaine',
      addressCountry: 'FR',
    },
  },
  areaServed: {
    '@type': 'City',
    name: 'Bordeaux',
  },
  offers: {
    '@type': 'Offer',
    price: '30',
    priceCurrency: 'EUR',
    description: 'Séance collective à l\'unité, par chien',
  },
};
---

<Layout title={page.metaTitle} description={page.metaDescription} jsonLd={jsonLd}>

  <!-- ── HERO ─────────────────────────────────────────────────────────── -->
  <section class="hero svc-hero" aria-labelledby="svc-h1">
    <picture>
      <source media="(min-width: 768px)" srcset="/images/hero-cours-collectifs-desktop.webp" />
      <img
        src="/images/hero-cours-collectifs-mobile.webp"
        alt=""
        class="svc-hero-img"
        fetchpriority="high"
        decoding="async"
        width="750"
        height="421"
      />
    </picture>
    <div class="container">
      <div class="svc-hero-content">
        <span class="svc-location-pill">
          <Icon name="map-pin" width={13} height={13} strokeWidth={2} />
          {hero.eyebrow}
        </span>
        <h1 id="svc-h1" class="svc-h1">
          {hero.headline}<br>
          {hero.headlineLine2} <span class="svc-acc">{hero.accent}</span>
        </h1>
        <p class="svc-lede">{hero.lede}</p>
        <div class="svc-btn-group">
          <a href="/prendre-rdv/" class="btn btn-primary">
            <Icon name="calendar" width={16} height={16} strokeWidth={2} />
            Prendre RDV
          </a>
          <a href="/tarif-educateur-canin-bordeaux/" class="svc-btn-ghost">Voir les tarifs</a>
        </div>
      </div>
    </div>
  </section>


  <!-- ── POURQUOI UN COURS COLLECTIF ───────────────────────────────────── -->
  <section class="section svc-section-white" id="pourquoi" aria-labelledby="pourquoi-heading">
    <div class="container">
      <h2 id="pourquoi-heading">Pourquoi choisir un cours <span class="accent">collectif ?</span></h2>
      <p class="ci-intro">Un cours collectif d'éducation canine à Bordeaux avec Kind Dog Training, c'est l'occasion de travailler avec votre chien dans un environnement stimulant tout en lui offrant des rencontres positives et encadrées avec d'autres chiens et d'autres maîtres.</p>
      <p class="ci-intro">Ce format vient en complément des cours individuels : il permet de mettre à l'épreuve les acquis travaillés en tête-à-tête et de continuer à faire progresser votre chien. Je sélectionne avec soin les chiens de chaque groupe pour m'assurer que la séance se déroule bien et profite à tout le monde.</p>
      <div class="ci-benefits-grid">
        {benefits.map((b) => (
          <div class="ci-benefit-card">
            <div class="ci-benefit-icon" aria-hidden="true">
              <Icon name={b.icon} width={22} height={22} strokeWidth={1.75} />
            </div>
            <p class="ci-benefit-title">{b.title}</p>
            <p class="ci-benefit-text">{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- WAVE : white → cream -->
  <div class="wave-separator wave-sep--from-white" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 80" preserveAspectRatio="none">
      <path fill="#F4ECDC" d="M0,40 C360,0 1080,80 1440,40 L1440,80 L0,80 Z"/>
    </svg>
  </div>

  <!-- ── DÉROULEMENT D'UNE SÉANCE ──────────────────────────────────────── -->
  <section class="section ci-section-deroulement" id="deroulement" aria-labelledby="deroulement-heading">
    <div class="container">
      <div class="ci-deroulement-grid">

        <!-- H2 : mobile order 1 / desktop col droite ligne 1 -->
        <h2 id="deroulement-heading" class="ci-deroulement-h2">
          Comment se déroule <span class="accent">une séance ?</span>
        </h2>

        <!-- Image : mobile order 2 / desktop col gauche (2 lignes) -->
        <div class="ci-deroulement-visual">
          <img
            src="/images/cours-collectifs-deroulement.webp"
            alt="cours collectif d'éducation canine à Bordeaux avec Kind Dog Training"
            class="ci-deroulement-img"
            loading="lazy"
            decoding="async"
            width="750"
            height="1000"
          />
        </div>

        <!-- Étapes : mobile order 3 / desktop col droite ligne 2 -->
        <div class="ci-steps">
          {deroulement.map((step) => (
            <div class="ci-step">
              <div class="ci-step-icon" aria-hidden="true">
                <Icon name={step.icon} width={22} height={22} strokeWidth={1.75} />
              </div>
              <div>
                <p class="ci-step-title">{step.title}</p>
                <p class="ci-step-desc" set:html={step.desc} />
              </div>
            </div>
          ))}
          <div class="ci-steps-cta">
            <a href="/prendre-rdv/" class="btn btn-primary">
              <Icon name="calendar" width={16} height={16} strokeWidth={2} />
              Prendre RDV
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- WAVE : cream → paper -->
  <div class="wave-separator wave-sep--from-cream" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 80" preserveAspectRatio="none">
      <path fill="#FBF6EC" d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z"/>
    </svg>
  </div>

  <!-- ── TARIFS ────────────────────────────────────────────────────────── -->
  <section class="section section-paper" id="tarifs" aria-labelledby="tarifs-heading">
    <div class="container" style="max-width: 640px;">
      <h2 id="tarifs-heading" style="text-align: center;">Tarifs des cours collectifs <span class="accent">à Bordeaux</span></h2>
      <div class="svc-price-card" style="margin-top: var(--sp-8);">
        <p class="svc-price-label">Par chien et par séance</p>
        <div class="svc-price-row">
          <span class="svc-price-num">30 €</span>
          <span class="svc-price-unit">/ chien / séance</span>
        </div>
        <p class="svc-price-pack">
          Groupes de 6 chiens maximum
        </p>
        <p class="svc-price-free">
          <span class="svc-check-mark" aria-hidden="true">✓</span>
          Bilan comportemental gratuit à domicile
        </p>
      </div>
      <div style="text-align: center; margin-top: var(--sp-6);">
        <a href="/tarif-educateur-canin-bordeaux/" class="ci-link-tarifs">
          Voir tous les tarifs et packs
          <Icon name="arrow-right" width={15} height={15} strokeWidth={2} />
        </a>
      </div>
    </div>
  </section>


  <!-- ── AVIS ──────────────────────────────────────────────────────────── -->
  <section class="kdtA" id="avis" aria-labelledby="svc-avis-heading">
    <div class="svc-kdta-inner">
      <div class="kdtA__header">
        <div class="kdtA__intro">
          <p class="kdtA__eyebrow">Avis Google · 5,0 / 5 sur 15 avis</p>
          <h2 id="svc-avis-heading" class="kdtA__title">
            Ils ont fait confiance à <span class="accent">Kind Dog Training</span>
          </h2>
        </div>
      </div>
      <div class="svc-reviews-grid">
        {reviews.map((r) => (
          <article class="kdtA__card">
            <div class="kdtA__card-head">
              <div class="kdtA__avatar" style={`background: ${r.gradient};`}>{initials(r.name)}</div>
              <div class="kdtA__name-block">
                <div class="kdtA__name">{r.name}</div>
                <div class="kdtA__date">{r.date}</div>
              </div>
            </div>
            <div class="kdtA__stars" aria-label="5 étoiles sur 5">
              {[...Array(5)].map(() => (
                <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                  <path
                    d="M12 2.5l2.95 6.6 7.05.7-5.35 4.85 1.6 7.35L12 18l-6.25 4 1.6-7.35L2 9.8l7.05-.7L12 2.5z"
                    fill="#E8A33D" stroke="#E8A33D" stroke-width="1.2" stroke-linejoin="round"
                  />
                </svg>
              ))}
            </div>
            <p class="kdtA__text">{r.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>


  <!-- ── ZONE STRIP ─────────────────────────────────────────────────────── -->
  <section class="svc-zone-strip" aria-label="Zone d'intervention">
    <span class="svc-zone-label">
      <Icon name="map-pin" width={14} height={14} strokeWidth={2} />
      Je me déplace à&nbsp;:
    </span>
    <div class="svc-zone-marquee-outer" aria-hidden="true">
      <div class="svc-zone-marquee-inner">
        {zones.map((z) => (
          <Fragment>
            <span class="svc-zone-sep">·</span>
            <span class="svc-zone-name">{z}</span>
          </Fragment>
        ))}
        <span class="svc-zone-sep">·</span>
        <span class="svc-zone-more">+ 17 communes · jusqu'à 30&nbsp;km</span>
        {zones.map((z) => (
          <Fragment>
            <span class="svc-zone-sep">·</span>
            <span class="svc-zone-name">{z}</span>
          </Fragment>
        ))}
        <span class="svc-zone-sep">·</span>
        <span class="svc-zone-more">+ 17 communes · jusqu'à 30&nbsp;km</span>
      </div>
    </div>
    <div class="svc-zone-static" aria-hidden="true">
      {zones.map((z) => (
        <Fragment>
          <span class="svc-zone-sep">·</span>
          <span class="svc-zone-name">{z}</span>
        </Fragment>
      ))}
      <span class="svc-zone-sep">·</span>
      <span class="svc-zone-more">+ 17 communes · jusqu'à 30&nbsp;km</span>
    </div>
  </section>


  <!-- ── FAQ ─────────────────────────────────────────────────────────── -->
  <section class="section" id="faq" aria-labelledby="faq-heading">
    <div class="container" style="max-width: 750px;">
      <h2 id="faq-heading" style="text-align: center;">Questions fréquentes sur mes <span class="accent">cours collectifs</span></h2>
      <div class="faq-list" style="margin-top: var(--sp-8);">
        {faqItems.map((item) => (
          <details class="faq-item">
            <summary class="faq-question">
              <h3 class="faq-h3">{item.question}</h3>
              <svg class="faq-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="faq-answer">
              <p set:html={item.answer} />
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>


  <!-- ── CTA ───────────────────────────────────────────────────────────── -->
  <section class="section section-dark cta-section" aria-labelledby="svc-cta-heading">
    <div class="container">
      <div class="cta-bilan-card">
        <p class="svc-cta-title" id="svc-cta-heading">
          Réservez votre bilan comportemental <span class="accent">offert</span>
        </p>
        <p style="text-align: center; margin-bottom: var(--sp-6);">
          Chaque accompagnement débute par un bilan gratuit à votre domicile, sans engagement.
          On évalue ensemble si le format collectif est adapté à votre chien et on planifie la suite.
        </p>
        <div style="text-align: center;">
          <a href="/prendre-rdv/" class="btn btn-primary">
            <Icon name="calendar" width={18} height={18} strokeWidth={1.75} />
            Prendre RDV
          </a>
        </div>
        <p style="text-align: center; margin-top: var(--sp-5); font-size: 0.8rem; color: var(--kd-fawn);">
          *Bilan comportemental à 20&nbsp;€ si &gt;20&nbsp;km.
        </p>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

</Layout>

<style>
/* ══ HERO ════════════════════════════════════════════════════════════════ */

.svc-section-white {
  background: var(--kd-white);
}

.svc-hero {
  align-items: flex-end;
  justify-content: flex-start;
  text-align: left;
}

.svc-hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  z-index: 0;
}

/* Overlay et contenu doivent être au-dessus de l'image */
.svc-hero::before {
  z-index: 1;
}

.svc-hero-content {
  z-index: 2;
}

.svc-hero::before {
  background: rgba(255, 255, 255, 0.45);
}

.svc-hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--sp-4);
}

.svc-location-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 14px;
  border-radius: var(--radius-pill);
  background: rgba(42, 30, 21, 0.07);
  border: 1px solid rgba(42, 30, 21, 0.22);
  font-size: 12px;
  font-weight: 600;
  color: var(--kd-ink);
}

.svc-h1 {
  font-family: var(--font-serif);
  font-size: clamp(34px, 4.8vw, 62px);
  font-weight: 500;
  line-height: 1.05;
  letter-spacing: -0.025em;
  color: var(--kd-ink);
  margin-bottom: 0;
  max-width: 640px;
}

@media (min-width: 768px) {
  .svc-h1 {
    max-width: 960px;
  }
}

.svc-acc { color: var(--kd-terracotta); }

.svc-lede {
  font-size: 19px;
  font-weight: 600;
  line-height: 1.6;
  color: var(--kd-ink);
  text-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
  max-width: 480px;
  margin-bottom: 0;
}

.svc-btn-group {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  margin-top: var(--sp-2);
}

.svc-btn-ghost {
  display: inline-flex;
  align-items: center;
  padding: 13.5px 28.5px;
  border-radius: var(--radius-pill);
  border: 1.5px solid var(--kd-bark);
  font-family: var(--font-sans);
  font-weight: 600;
  font-size: 15px;
  color: var(--kd-ink);
  text-decoration: none;
  transition:
    background-color var(--dur-base) var(--ease-out),
    color var(--dur-base) var(--ease-out),
    border-color var(--dur-base) var(--ease-out);
}
.svc-btn-ghost:hover {
  background-color: var(--kd-ink);
  border-color: var(--kd-ink);
  color: var(--kd-white);
  text-decoration: none;
}

/* ══ INTRO ══════════════════════════════════════════════════════════════ */

.ci-intro {
  color: var(--kd-bark);
  max-width: 680px;
  margin-bottom: var(--sp-8);
}

/* ══ BENEFITS GRID ══════════════════════════════════════════════════════ */

.ci-benefits-grid {
  display: grid;
  gap: var(--sp-5);
}

.ci-benefit-card {
  background: var(--kd-cream-warm);
  border-radius: var(--radius-lg);
  padding: var(--sp-8);
  box-shadow: var(--shadow-xs);
  transition:
    box-shadow var(--dur-base) var(--ease-out),
    transform var(--dur-base) var(--ease-out);
}

