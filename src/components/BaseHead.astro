---
import { Font } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  preloadImages?: Array<{ href: string; media?: string }>;
}

const {
  title,
  description,
  ogImage = '/images/og-default.jpg',
  canonicalUrl,
  type = 'website',
  jsonLd,
  preloadImages,
} = Astro.props;

const siteUrl = Astro.site?.origin ?? 'https://kind-dog-training.fr';
const resolvedCanonical = canonicalUrl
  ? (canonicalUrl.startsWith('http') ? canonicalUrl : `${siteUrl}${canonicalUrl}`)
  : Astro.url.href;
const canonical = resolvedCanonical;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!-- Consent Mode v2 — initialisation avant GTM -->
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  window.gtag = gtag;

  // Tous les signaux à 'denied' par défaut (Consent Mode v2)
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    functionality_storage: 'denied',
    personalization_storage: 'denied',
    security_storage: 'granted',
    wait_for_update: 500
  });

  // Si un choix est déjà stocké, l'appliquer avant le chargement de GTM
  try {
    var m = document.cookie.match(/(?:^|;\s*)kdt_consent=([^;]+)/);
    if (m) {
      var c = JSON.parse(decodeURIComponent(m[1]));
      if (c && c.version === 1) {
        var g = c.analytics ? 'granted' : 'denied';
        gtag('consent', 'update', {
          analytics_storage: g,
          functionality_storage: g,
          personalization_storage: g
        });
      }
    }
  } catch (e) {}
</script>

<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-KLVBXJK4');</script>
<!-- End Google Tag Manager -->

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- Polices auto-hébergées (Astro Fonts API) — latin, woff2, font-display: swap -->
<!-- Preload ciblé des graisses above-the-fold uniquement (titres Newsreader 500, corps Nunito 400) -->
<Font cssVariable="--font-newsreader" preload={[{ weight: 500, style: 'normal', subset: 'latin' }]} />
<Font cssVariable="--font-nunito" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />

<!-- Preload above-the-fold images -->
{preloadImages?.map(img => (
  <link rel="preload" as="image" href={img.href} media={img.media} type="image/webp" fetchpriority="high" />
))}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:site_name" content="Kind Dog Training" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Favicon -->
<link rel="icon" type="image/png" href="/images/logo.png" />
<link rel="apple-touch-icon" href="/images/logo.png" />

{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
