---
import { Font } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  preloadImages?: Array<{ href: string; media?: string }>;
}

const {
  title,
  description,
  ogImage = '/images/og-default.jpg',
  canonicalUrl,
  type = 'website',
  jsonLd,
  preloadImages,
} = Astro.props;

const siteUrl = Astro.site?.origin ?? 'https://kind-dog-training.fr';
const resolvedCanonical = canonicalUrl
  ? (canonicalUrl.startsWith('http') ? canonicalUrl : `${siteUrl}${canonicalUrl}`)
  : Astro.url.href;
const canonical = resolvedCanonical;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!-- Google tag (gtag.js) — Consent Mode v2 -->
<script>
  // Initialiser dataLayer + gtag AVANT le chargement de gtag.js
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  window.gtag = gtag;

  // Tous les signaux à 'denied' par défaut (Consent Mode v2)
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    functionality_storage: 'denied',
    personalization_storage: 'denied',
    security_storage: 'granted',
    wait_for_update: 500
  });

  // Si un choix est déjà stocké, l'appliquer avant gtag('config')
  try {
    var m = document.cookie.match(/(?:^|;\s*)kdt_consent=([^;]+)/);
    if (m) {
      var c = JSON.parse(decodeURIComponent(m[1]));
      if (c && c.version === 1) {
        var g = c.analytics ? 'granted' : 'denied';
        gtag('consent', 'update', {
          analytics_storage: g,
          functionality_storage: g,
          personalization_storage: g
        });
      }
    }
  } catch (e) {}

  gtag('js', new Date());
  gtag('config', 'G-Q5R11EJXQV');
</script>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-Q5R11EJXQV"></script>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- Polices auto-hébergées (Astro Fonts API) — latin, woff2, font-display: swap -->
<Font cssVariable="--font-newsreader" />
<Font cssVariable="--font-nunito" />

<!-- Preload above-the-fold images -->
{preloadImages?.map(img => (
  <link rel="preload" as="image" href={img.href} media={img.media} type="image/webp" fetchpriority="high" />
))}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:site_name" content="Kind Dog Training" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Favicon -->
<link rel="icon" type="image/png" href="/images/logo.png" />
<link rel="apple-touch-icon" href="/images/logo.png" />

{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
