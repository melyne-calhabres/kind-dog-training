          <li><a href="/mentions-legales/" class="muted">Mentions légales & confidentialité</a></li>
          <li><a href="/partenaires/" class="muted">Partenaires</a></li>
          <li><a href="#" class="muted" data-kdt-consent-open>Gérer mes cookies</a></li>
        </ul>
      </nav>

      <address>
        <p class="footer-col-title">Contact</p>
        <ul class="footer-col-links">
          <li>kindogtraining@gmail.com</li>
          <li>
            <a href="https://www.instagram.com/kind_dog_training/" target="_blank" rel="noopener noreferrer" class="footer-instagram-link">
