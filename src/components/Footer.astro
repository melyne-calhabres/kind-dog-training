    <div class="footer-grid">
      <div>
        <a href="/" aria-label="Kind Dog Training — Accueil">
          <picture>
            <source srcset="/images/logo.webp" type="image/webp" />
            <img src="/images/logo.png" alt="Kind Dog Training" width="70" height="70" style="margin-bottom: 12px;" loading="lazy" decoding="async" />
          </picture>
        </a>
        <p class="footer-brand-desc">
          Education canine à Bordeaux et ses alentours.
        </p>
      </div>

      <nav aria-label="Menu du site">
        <p class="footer-col-title">Menu</p>
        <ul class="footer-col-links">
          <li><a href="/">Accueil</a></li>
          <li><a href="/tarif-educateur-canin-bordeaux">Tarifs</a></li>
          <li><a href="/qui-suis-je/">Qui suis-je ?</a></li>
          <li><a href="/prendre-rdv/">Prendre RDV</a></li>
        </ul>
      </nav>

      <nav aria-label="Services">
        <p class="footer-col-title">Services</p>
        <ul class="footer-col-links">
          <li><a href="/services/bilan-comportemental/">Bilan comportemental</a></li>
          <li><a href="/services/cours-individuel-education-canine-bordeaux/">Cours individuels</a></li>
